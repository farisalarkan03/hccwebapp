---
// Base Layout - shared HTML shell for all pages
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'event';
}

const {
  title,
  description = 'Happy Couple Class — Kelas pernikahan berbasis Islam untuk pasangan yang ingin membangun rumah tangga sakinah, mawaddah, dan rahmah.',
  image = '/img/og-default.jpg',
  noindex = false,
  ogType = 'website',
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://happycoupleclass.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Happy Couple Class" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="apple-touch-icon" href="/img/favicon.png" />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
