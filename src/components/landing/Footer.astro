---
// Footer component for public pages
// Follows Section 6.9: White background, --line top border, colored SVG logo, 4-column balanced grid
import { supabase } from '../../lib/supabase';

let whatsappNumber = '';
try {
  const { data: waSetting } = await supabase
    .from('site_settings')
    .select('value')
    .eq('key', 'whatsapp_number')
    .maybeSingle();
  if (waSetting?.value) {
    whatsappNumber = waSetting.value;
  }
} catch (e) {
  // Silent fallback
}
const waUrl = whatsappNumber 
  ? `https://wa.me/${whatsappNumber.replace(/[^0-9]/g, '')}` 
  : 'https://wa.me/628123456789';
---

<footer class="footer" role="contentinfo">
  <div class="container footer-inner">
    <!-- Kolom 1: Brand -->
    <div class="footer-brand">
      <a href="/" class="footer-logo-link" aria-label="Happy Couple Class - Beranda">
        <img
          src="/img/logo.png"
          alt=""
          width="38"
          height="38"
          class="footer-logo-img"
        />
        <div class="footer-logo-text">
          <span class="brand-title">Happy Couple</span>
          <span class="brand-subtitle">Class</span>
        </div>
      </a>
      <p class="footer-tagline">
        Kelas pernikahan berbasis Islam untuk pasangan yang ingin membangun rumah tangga sakinah, mawaddah, dan rahmah dilandasi ilmu dan syariat.
      </p>
      <div class="footer-social">
        <a
          href="https://instagram.com/happycoupleclass"
          target="_blank"
          rel="noopener noreferrer"
          class="social-badge"
          aria-label="Instagram Happy Couple Class"
        >
          <span class="social-icon-circle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </span>
          <span class="social-label">@happycoupleclass</span>
        </a>
      </div>
    </div>

    <!-- Kolom 2: Tautan -->
    <div class="footer-col">
      <h3 class="footer-col-title">Tautan</h3>
      <nav aria-label="Tautan navigasi footer" class="footer-nav">
        <a href="/#tentang" class="footer-link">Tentang HCC</a>
        <a href="/#event" class="footer-link">Event</a>
        <a href="/#cara-daftar" class="footer-link">Cara Daftar</a>
        <a href="/#faq" class="footer-link">FAQ</a>
      </nav>
    </div>

    <!-- Kolom 3: Informasi -->
    <div class="footer-col">
      <h3 class="footer-col-title">Informasi</h3>
      <nav aria-label="Informasi legal" class="footer-nav">
        <a href="/privasi" class="footer-link">Kebijakan Privasi</a>
        <a href="/p" class="footer-link">Artikel & Inspirasi</a>
      </nav>
    </div>

    <!-- Kolom 4: Kontak -->
    <div class="footer-col">
      <h3 class="footer-col-title">Kontak</h3>
      <div class="footer-contact">
        <p class="contact-desc">Punya pertanyaan seputar kelas atau pendaftaran?</p>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary btn-sm footer-wa-btn"
        >
          <span class="material-symbols-outlined" aria-hidden="true">chat</span>
          WhatsApp Admin
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copy">
        &copy; {new Date().getFullYear()} Happy Couple Class. Hak cipta dilindungi.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--white);
    color: var(--ink-700);
    border-top: 1px solid var(--line);
    padding-top: 72px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 56px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    width: fit-content;
  }

  .footer-logo-img {
    height: 38px;
    width: 38px;
    display: block;
    object-fit: contain;
    flex-shrink: 0;
  }

  .footer-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: -0.01em;
  }

  .brand-subtitle {
    font-size: 11px;
    font-weight: 600;
    color: var(--pink-600);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .footer-tagline {
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-600);
    max-width: 360px;
    margin: 0;
  }

  .footer-social {
    margin-top: 8px;
  }

  .social-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-700);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .social-badge:hover {
    color: var(--pink-600);
  }

  .social-icon-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-900);
    background: var(--white);
    transition: all 150ms ease;
  }

  .social-badge:hover .social-icon-circle {
    border-color: var(--pink-600);
    color: var(--pink-600);
    background: var(--pink-50);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-col-title {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-900);
    margin: 0;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    font-size: 14px;
    color: var(--ink-600);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-link:hover {
    color: var(--pink-600);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact-desc {
    font-size: 14px;
    color: var(--ink-600);
    line-height: 1.6;
    margin: 0;
  }

  .footer-wa-btn {
    width: fit-content;
  }

  .footer-bottom {
    border-top: 1px solid var(--line);
    padding: 24px 0;
    background: var(--pink-50);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .footer-copy {
    font-size: 14px;
    color: var(--ink-600);
    margin: 0;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding-top: 56px;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-bottom: 40px;
    }
  }
</style>
