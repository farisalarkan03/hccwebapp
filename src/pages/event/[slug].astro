---
export const prerender = false;

import PublicLayout from '../../layouts/PublicLayout.astro';
import { createServiceClient } from '../../lib/supabase';
import { formatDateWIB, formatRupiah } from '../../lib/format';
import { getServerEnv } from '../../lib/server-env';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const supabase = createServiceClient();

// Fetch event
const { data: event, error: eventError } = await supabase
  .from('events')
  .select(`
    *,
    categories (id, name),
    registrations (id, payment_status, deleted_at)
  `)
  .eq('slug', slug)
  .is('deleted_at', null)
  .single();

if (eventError || !event) {
  return Astro.redirect('/');
}

// Calculate quota
const regs = (event.registrations || []).filter((r: any) => !['expired', 'cancelled'].includes(r.payment_status) && !r.deleted_at);
const currentCount = regs.length;
const isFull = event.quota ? currentCount >= event.quota : false;
const remainingQuota = event.quota ? Math.max(0, event.quota - currentCount) : null;

const isOpen = event.status === 'open';
const canRegister = isOpen && (!isFull || event.waitlist_enabled);

// JSON-LD Structured Data for Event
const siteUrl = getServerEnv('PUBLIC_SITE_URL', import.meta.env.PUBLIC_SITE_URL || 'https://happycoupleclass.com');
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  description: event.description || event.title,
  startDate: event.date_start,
  endDate: event.date_end || event.date_start,
  eventStatus: isOpen ? 'https://schema.org/EventScheduled' : 'https://schema.org/EventCancelled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: event.location,
    address: {
      '@type': 'PostalAddress',
      addressLocality: event.location,
      addressCountry: 'ID',
    },
  },
  image: event.flyer_url ? [event.flyer_url] : undefined,
  offers: {
    '@type': 'Offer',
    url: `${siteUrl}/daftar/${event.slug}`,
    price: event.price_per_couple,
    priceCurrency: 'IDR',
    availability: canRegister ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut',
    validFrom: event.created_at,
  },
  organizer: {
    '@type': 'Organization',
    name: 'Happy Couple Class',
    url: siteUrl,
  },
};
---

<PublicLayout
  title={`${event.title} — Happy Couple Class`}
  description={event.description || `Ikuti ${event.title}. Kelas persiapan & penguatan pernikahan berbasis Islam bersama Happy Couple Class.`}
  image={event.flyer_url || '/img/og-default.jpg'}
  ogType="event"
>
  <slot name="head" slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  </slot>

  <div class="event-detail-page">
    <div class="container event-detail-container">
      <!-- Breadcrumb -->
      <nav class="event-breadcrumb" aria-label="Navigasi">
        <a href="/">Beranda</a>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <span>{event.categories?.name || 'Event'}</span>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <span aria-current="page">{event.title}</span>
      </nav>

      <!-- Main Layout: Grid 2 Columns -->
      <div class="event-layout-grid">
        <!-- Left: Flyer and Details -->
        <div class="event-main-col">
          {event.flyer_url ? (
            <div class="event-flyer-wrap">
              <img
                src={event.flyer_url}
                alt={`Flyer ${event.title}`}
                class="event-flyer-img"
                loading="eager"
              />
            </div>
          ) : (
            <div class="event-flyer-placeholder">
              <span class="material-symbols-outlined flyer-placeholder-icon" aria-hidden="true">celebration</span>
              <span>Happy Couple Class</span>
            </div>
          )}

          <div class="event-content-card">
            <div class="event-category-row">
              <span class="badge badge-pink">{event.categories?.name || 'Kelas Pernikahan'}</span>
              <span class={`badge ${
                isOpen ? (isFull ? 'badge-warn' : 'badge-ok') : 'badge-neutral'
              }`}>
                {isOpen ? (isFull ? (event.waitlist_enabled ? 'Antrean (Waitlist)' : 'Kuota Penuh') : 'Pendaftaran Buka') : 'Pendaftaran Tutup'}
              </span>
            </div>

            <h1 class="event-title-h1">{event.title}</h1>

            <div class="event-description-body">
              {event.description ? (
                <div class="description-text">
                  {event.description.split('\n').map((paragraph: string) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              ) : (
                <p class="description-text">
                  Bergabunglah dalam sesi intensif Happy Couple Class yang dirancang khusus untuk membekali pasangan suami istri dengan ilmu, pemahaman syariat, dan keterampilan komunikasi keluarga yang harmonis dan penuh berkah.
                </p>
              )}
            </div>
          </div>
        </div>

        <!-- Right: Registration Action Card Sticky -->
        <div class="event-sidebar-col">
          <div class="sticky-card">
            <div class="sidebar-price-header">
              <span class="price-lbl">Investasi per Couple</span>
              <span class="price-val">{formatRupiah(event.price_per_couple)}</span>
              <span class="price-sub">Berlaku untuk 1 pasangan (suami &amp; istri)</span>
            </div>

            <div class="sidebar-details-list">
              <div class="sidebar-detail-item">
                <span class="material-symbols-outlined icon-pink" aria-hidden="true">calendar_month</span>
                <div class="detail-item-content">
                  <strong>Tanggal &amp; Waktu</strong>
                  <span>{formatDateWIB(event.date_start, { showTime: true })}</span>
                  {event.date_end && (
                    <span class="text-sm">s.d {formatDateWIB(event.date_end, { showTime: true })}</span>
                  )}
                </div>
              </div>

              <div class="sidebar-detail-item">
                <span class="material-symbols-outlined icon-pink" aria-hidden="true">location_on</span>
                <div class="detail-item-content">
                  <strong>Lokasi Acara</strong>
                  <span>{event.location}</span>
                  {event.location_map_url && (
                    <a
                      href={event.location_map_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="map-link"
                    >
                      Buka di Google Maps
                      <span class="material-symbols-outlined icon-sm" aria-hidden="true">open_in_new</span>
                    </a>
                  )}
                </div>
              </div>

              {event.quota && (
                <div class="sidebar-detail-item">
                  <span class="material-symbols-outlined icon-pink" aria-hidden="true">group</span>
                  <div class="detail-item-content">
                    <strong>Sisa Kuota</strong>
                    <span>
                      {isFull
                        ? 'Kuota telah terpenuhi'
                        : `${remainingQuota} couple tersisa dari total ${event.quota}`}
                    </span>
                  </div>
                </div>
              )}
            </div>

            <div class="sidebar-action-wrap">
              {canRegister ? (
                <a
                  href={`/daftar/${event.slug}`}
                  class="btn btn-primary btn-full btn-lg action-register-btn"
                >
                  {isFull && event.waitlist_enabled ? 'Daftar Antrean (Waiting List)' : 'Daftar Sekarang'}
                  <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
              ) : (
                <button
                  type="button"
                  class="btn btn-secondary btn-full btn-lg"
                  disabled
                >
                  Pendaftaran Ditutup
                </button>
              )}
              <span class="secure-note">
                <span class="material-symbols-outlined icon-sm" aria-hidden="true">lock</span>
                Pendaftaran resmi via Happy Couple Class
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</PublicLayout>

<style>
  .event-detail-page {
    background-color: var(--pink-50);
    min-height: calc(100vh - 160px);
    padding: 32px 0 80px 0;
  }

  .event-detail-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .event-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--ink-600);
  }

  .event-breadcrumb a {
    color: var(--pink-500);
    text-decoration: none;
  }

  .event-breadcrumb a:hover {
    text-decoration: underline;
  }

  .event-breadcrumb .material-symbols-outlined {
    font-size: 16px;
    color: var(--ink-400);
  }

  .event-layout-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 32px;
    align-items: start;
  }

  .event-main-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .event-flyer-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }

  .event-flyer-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .event-flyer-placeholder {
    height: 280px;
    background: linear-gradient(135deg, var(--pink-100) 0%, var(--pink-200) 100%);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--pink-600);
    font-weight: 600;
    font-size: 18px;
  }

  .flyer-placeholder-icon {
    font-size: 48px;
  }

  .event-content-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .event-category-row {
    display: flex;
    gap: 8px;
  }

  .event-title-h1 {
    font-size: 28px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .event-description-body {
    color: var(--ink-600);
    font-size: 15px;
    line-height: 1.75;
  }

  .description-text p {
    margin: 0 0 14px 0;
  }

  .description-text p:last-child {
    margin: 0;
  }

  /* Sidebar Sticky Card */
  .sticky-card {
    position: sticky;
    top: 96px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .sidebar-price-header {
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .price-lbl {
    font-size: 13px;
    color: var(--ink-600);
    font-weight: 500;
  }

  .price-val {
    font-size: 32px;
    font-weight: 700;
    color: var(--pink-600);
    letter-spacing: -0.02em;
  }

  .price-sub {
    font-size: 12px;
    color: var(--ink-400);
  }

  .sidebar-details-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .sidebar-detail-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .icon-pink {
    color: var(--pink-500);
    font-size: 22px;
    margin-top: 2px;
  }

  .detail-item-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
  }

  .detail-item-content strong {
    color: var(--ink-900);
    font-size: 13px;
  }

  .detail-item-content span {
    color: var(--ink-600);
  }

  .text-sm {
    font-size: 12px;
    color: var(--ink-400);
  }

  .map-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: var(--pink-500);
    text-decoration: none;
    margin-top: 2px;
  }

  .map-link:hover { text-decoration: underline; }
  .icon-sm { font-size: 14px; }

  .sidebar-action-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .action-register-btn {
    font-size: 16px;
    font-weight: 600;
    gap: 8px;
  }

  .secure-note {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 11px;
    color: var(--ink-400);
  }

  @media (max-width: 960px) {
    .event-layout-grid {
      grid-template-columns: 1fr;
    }
    .sticky-card {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .event-title-h1 {
      font-size: 22px;
    }
    .price-val {
      font-size: 26px;
    }
    .event-content-card, .sticky-card {
      padding: 24px 20px;
    }
  }
</style>
