---
export const prerender = false;

import PublicLayout from '../../layouts/PublicLayout.astro';
import { createServiceClient } from '../../lib/supabase';
import { formatDateWIB, formatRupiah } from '../../lib/format';

let events: any[] = [];
let categories: any[] = [];

try {
  const supabase = createServiceClient();

  const { data: catList } = await supabase
    .from('categories')
    .select('id, name')
    .order('name');
  if (catList) categories = catList;

  const { data: eventList } = await supabase
    .from('events')
    .select(`
      id,
      title,
      slug,
      description,
      flyer_url,
      date_start,
      date_end,
      location,
      price_per_couple,
      quota,
      status,
      waitlist_enabled,
      categories (id, name),
      registrations (id, payment_status, deleted_at)
    `)
    .is('deleted_at', null)
    .in('status', ['open', 'closed'])
    .order('date_start', { ascending: true });

  if (eventList) events = eventList;
} catch (err) {
  console.warn('Supabase error:', err);
}

// Compute quota info per event
const eventsWithQuota = events.map((ev) => {
  const regs = (ev.registrations || []).filter(
    (r: any) => !['expired', 'cancelled'].includes(r.payment_status) && !r.deleted_at
  );
  const count = regs.length;
  const isFull = ev.quota ? count >= ev.quota : false;
  const remaining = ev.quota ? Math.max(0, ev.quota - count) : null;
  const canRegister = ev.status === 'open' && (!isFull || ev.waitlist_enabled);
  return { ...ev, isFull, remaining, canRegister };
});

const openEvents = eventsWithQuota.filter((e) => e.status === 'open');
const pastEvents = eventsWithQuota.filter((e) => e.status === 'closed');
---

<PublicLayout
  title="Semua Jadwal Kelas — Happy Couple Class"
  description="Lihat semua jadwal kelas Happy Couple Class yang tersedia. Daftar sekarang untuk kelas pernikahan islami terbaik bersama pasangan Anda."
>
  <!-- Page Header -->
  <section class="events-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Navigasi">
        <a href="/">Beranda</a>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <span aria-current="page">Jadwal Kelas</span>
      </nav>

      <div class="header-content">
        <span class="section-tag">Jadwal Tersedia</span>
        <h1 class="page-title">
          Semua Jadwal <em class="italic-pink">Kelas HCC</em>
        </h1>
        <p class="page-desc">
          1 Pendaftaran berlaku untuk 1 couple (suami &amp; istri). Kuota terbatas
          untuk menjaga kualitas setiap sesi kelas.
        </p>
      </div>
    </div>
  </section>

  <!-- Open Events -->
  <section class="events-list-section">
    <div class="container">
      {openEvents.length === 0 && pastEvents.length === 0 && (
        <div class="empty-state">
          <span class="material-symbols-outlined empty-icon" aria-hidden="true">event_busy</span>
          <h2 class="empty-title">Belum Ada Jadwal Tersedia</h2>
          <p class="empty-desc">
            Jadwal kelas sedang dalam persiapan. Pantau terus Instagram kami
            untuk informasi batch terbaru.
          </p>
          <a
            href="https://instagram.com/happycoupleclass"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-md"
          >
            <span class="material-symbols-outlined" aria-hidden="true">photo_camera</span>
            Ikuti @happycoupleclass
          </a>
        </div>
      )}

      {openEvents.length > 0 && (
        <div class="events-group">
          <h2 class="group-title">
            <span class="status-dot status-open"></span>
            Pendaftaran Sedang Buka
            <span class="group-count">{openEvents.length} kelas</span>
          </h2>
          <div class="events-grid">
            {openEvents.map((ev) => (
              <div class="event-card">
                {ev.flyer_url ? (
                  <div class="card-img-wrap">
                    <img src={ev.flyer_url} alt={ev.title} class="card-img" loading="lazy" />
                    <span class={`card-status-badge ${ev.isFull ? 'badge-full' : 'badge-open'}`}>
                      {ev.isFull ? (ev.waitlist_enabled ? 'Waitlist' : 'Penuh') : 'Buka'}
                    </span>
                  </div>
                ) : (
                  <div class="card-img-placeholder">
                    <span class="material-symbols-outlined" aria-hidden="true">celebration</span>
                    <span class={`card-status-badge ${ev.isFull ? 'badge-full' : 'badge-open'}`}>
                      {ev.isFull ? (ev.waitlist_enabled ? 'Waitlist' : 'Penuh') : 'Buka'}
                    </span>
                  </div>
                )}

                <div class="card-body">
                  <div class="card-category">{ev.categories?.name || 'Kelas Pernikahan'}</div>
                  <h3 class="card-title"><a href={`/event/${ev.slug}`}>{ev.title}</a></h3>

                  <div class="card-meta-list">
                    <div class="card-meta-item">
                      <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                      <span>{formatDateWIB(ev.date_start, { showTime: true })}</span>
                    </div>
                    <div class="card-meta-item">
                      <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                      <span>{ev.location}</span>
                    </div>
                    {ev.quota && (
                      <div class="card-meta-item">
                        <span class="material-symbols-outlined" aria-hidden="true">group</span>
                        <span>{ev.isFull ? 'Kuota penuh' : `${ev.remaining} dari ${ev.quota} couple tersisa`}</span>
                      </div>
                    )}
                  </div>

                  <div class="card-footer">
                    <div class="price-wrap">
                      <span class="price-lbl">Per couple</span>
                      <span class="price-val">{formatRupiah(ev.price_per_couple)}</span>
                    </div>
                    <div class="card-actions">
                      <a href={`/event/${ev.slug}`} class="btn btn-secondary btn-sm">Detail</a>
                      {ev.canRegister && (
                        <a href={`/daftar/${ev.slug}`} class="btn btn-primary btn-sm">
                          {ev.isFull ? 'Waitlist' : 'Daftar'}
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {pastEvents.length > 0 && (
        <div class="events-group">
          <h2 class="group-title">
            <span class="status-dot status-closed"></span>
            Kelas Sebelumnya
            <span class="group-count">{pastEvents.length} kelas</span>
          </h2>
          <div class="events-grid events-grid--muted">
            {pastEvents.map((ev) => (
              <div class="event-card event-card--muted">
                {ev.flyer_url ? (
                  <div class="card-img-wrap">
                    <img src={ev.flyer_url} alt={ev.title} class="card-img card-img--muted" loading="lazy" />
                    <span class="card-status-badge badge-closed">Selesai</span>
                  </div>
                ) : (
                  <div class="card-img-placeholder card-img-placeholder--muted">
                    <span class="material-symbols-outlined" aria-hidden="true">event_available</span>
                    <span class="card-status-badge badge-closed">Selesai</span>
                  </div>
                )}

                <div class="card-body">
                  <div class="card-category">{ev.categories?.name || 'Kelas Pernikahan'}</div>
                  <h3 class="card-title card-title--muted">
                    <a href={`/event/${ev.slug}`}>{ev.title}</a>
                  </h3>
                  <div class="card-meta-list">
                    <div class="card-meta-item">
                      <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                      <span>{formatDateWIB(ev.date_start, { showTime: true })}</span>
                    </div>
                    <div class="card-meta-item">
                      <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                      <span>{ev.location}</span>
                    </div>
                  </div>
                  <div class="card-footer">
                    <div class="price-wrap">
                      <span class="price-lbl">Per couple</span>
                      <span class="price-val price-val--muted">{formatRupiah(ev.price_per_couple)}</span>
                    </div>
                    <a href={`/event/${ev.slug}`} class="btn btn-secondary btn-sm">Lihat Info</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bottom-cta">
    <div class="container cta-inner">
      <span class="material-symbols-outlined cta-icon" aria-hidden="true">favorite</span>
      <h2 class="cta-title">Belum menemukan jadwal yang cocok?</h2>
      <p class="cta-desc">
        Daftarkan diri ke waitlist dan kami akan menghubungi Anda saat batch
        baru dibuka. Atau hubungi kami langsung via WhatsApp.
      </p>
      <div class="cta-actions">
        <a
          href="https://wa.me/628123456789"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-md"
        >
          <span class="material-symbols-outlined" aria-hidden="true">chat</span>
          Hubungi via WhatsApp
        </a>
        <a href="/" class="btn btn-secondary btn-md">Kembali ke Beranda</a>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  /* Header */
  .events-header {
    background: var(--white);
    padding: 40px 0 56px 0;
    border-bottom: 1px solid var(--line);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--ink-600);
    margin-bottom: 32px;
  }
  .breadcrumb a { color: var(--pink-500); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb .material-symbols-outlined { font-size: 16px; color: var(--ink-400); }

  .header-content { max-width: 680px; }

  .section-tag {
    font-size: 12px;
    font-weight: 700;
    color: var(--pink-600);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 10px;
  }

  .page-title {
    font-size: 40px;
    font-weight: 700;
    color: var(--ink-900);
    margin: 0 0 14px 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .italic-pink { font-style: italic; color: var(--pink-500); }

  .page-desc {
    font-size: 16px;
    color: var(--ink-600);
    line-height: 1.7;
    margin: 0;
    max-width: 560px;
  }

  /* Events List */
  .events-list-section {
    padding: 64px 0 80px 0;
    background: var(--pink-50);
    min-height: 400px;
  }

  .events-group {
    margin-bottom: 64px;
  }
  .events-group:last-child { margin-bottom: 0; }

  .group-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 28px 0;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-open  { background: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,.2); }
  .status-closed { background: var(--ink-400); }

  .group-count {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-500);
    background: var(--white);
    border: 1px solid var(--line);
    padding: 2px 10px;
    border-radius: 20px;
    margin-left: 4px;
  }

  /* Cards Grid */
  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }

  .event-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .event-card--muted {
    opacity: 0.75;
  }
  .event-card--muted:hover { opacity: 1; }

  .card-img-wrap {
    position: relative;
    height: 210px;
    overflow: hidden;
  }

  .card-img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }
  .event-card:hover .card-img { transform: scale(1.04); }
  .card-img--muted { filter: grayscale(30%); }

  .card-img-placeholder {
    height: 210px;
    background: linear-gradient(135deg, var(--pink-100) 0%, var(--pink-200) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .card-img-placeholder .material-symbols-outlined { font-size: 52px; color: var(--pink-400); }
  .card-img-placeholder--muted { filter: grayscale(50%); }

  .card-status-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }
  .badge-open   { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
  .badge-full   { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
  .badge-closed { background: #f3f4f6; color: #6b7280; border: 1px solid #e5e7eb; }

  /* Card Body */
  .card-body {
    padding: 20px 24px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 12px;
  }

  .card-category {
    font-size: 11px;
    font-weight: 700;
    color: var(--pink-600);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0;
    line-height: 1.4;
  }
  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .card-title a:hover { color: var(--pink-600); }
  .card-title--muted { color: var(--ink-700); }

  .card-meta-list {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 13px;
    color: var(--ink-600);
  }
  .card-meta-item { display: flex; align-items: center; gap: 8px; }
  .card-meta-item .material-symbols-outlined { font-size: 17px; color: var(--pink-400); flex-shrink: 0; }

  .card-footer {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .price-wrap { display: flex; flex-direction: column; gap: 1px; }
  .price-lbl { font-size: 11px; color: var(--ink-400); }
  .price-val { font-size: 15px; font-weight: 700; color: var(--pink-600); }
  .price-val--muted { color: var(--ink-500); }
  .card-actions { display: flex; gap: 8px; }

  /* Empty */
  .empty-state {
    text-align: center;
    padding: 80px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .empty-icon { font-size: 56px; color: var(--pink-300); }
  .empty-title { font-size: 22px; font-weight: 600; color: var(--ink-900); margin: 0; }
  .empty-desc { font-size: 15px; color: var(--ink-600); max-width: 480px; margin: 0; line-height: 1.7; }

  /* Bottom CTA */
  .bottom-cta {
    background: linear-gradient(135deg, #7c0042 0%, #b5006e 60%, #d44090 100%);
    padding: 72px 0;
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 560px;
  }

  .cta-icon { font-size: 40px; color: rgba(255,255,255,0.4); }
  .cta-title { font-size: 28px; font-weight: 700; color: #fff; margin: 0; }
  .cta-desc { font-size: 15px; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0; }
  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }

  @media (max-width: 640px) {
    .page-title { font-size: 28px; }
    .events-grid { grid-template-columns: 1fr; }
    .cta-actions { flex-direction: column; width: 100%; }
  }
</style>
