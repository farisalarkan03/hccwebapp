---
export const prerender = false;

import PublicLayout from '../layouts/PublicLayout.astro';
import { supabase } from '../lib/supabase';
import { formatDateWIB, formatRupiah } from '../lib/format';

let settingsMap: Record<string, any> = {};
let activeEvents: any[] = [];
let blogPages: any[] = [];

try {
  const { data: settingsList } = await supabase.from('site_settings').select('*');
  settingsList?.forEach((s) => { settingsMap[s.key] = s.value; });

  const { data: eventsList } = await supabase
    .from('events')
    .select(`id, title, slug, description, flyer_url, date_start, location, price_per_couple, quota, status, waitlist_enabled, categories (name), registrations (id, payment_status)`)
    .eq('status', 'open')
    .eq('show_on_landing', true)
    .is('deleted_at', null)
    .order('date_start', { ascending: true })
    .limit(3);

  if (eventsList && eventsList.length > 0) activeEvents = eventsList.map((ev: any) => {
    const regs = (ev.registrations || []).filter(
      (r: any) => !['expired', 'cancelled'].includes(r.payment_status)
    );
    const count = regs.length;
    const isFull = ev.quota ? count >= ev.quota : false;
    const remaining = ev.quota ? Math.max(0, ev.quota - count) : null;
    const canRegister = ev.status === 'open' && (!isFull || ev.waitlist_enabled);
    return { ...ev, isFull, remaining, canRegister };
  });

  // Fetch published pages to show as blog/inspiration
  const { data: pages } = await supabase
    .from('pages')
    .select('id, title, slug, summary, cover_url, published_at, created_at')
    .eq('status', 'published')
    .is('deleted_at', null)
    .order('published_at', { ascending: false, nullsFirst: false })
    .limit(3);

  if (pages && pages.length > 0) blogPages = pages;
} catch (err) {
  console.warn('Supabase query error:', err);
}

// Only use stats if actually present in site_settings (no made up numbers)
const statAlumni = settingsMap['stat_alumni'];
const statCities = settingsMap['stat_cities'];
const statSatisfaction = settingsMap['stat_satisfaction'];
const statBatches = settingsMap['stat_batches'];
const hasRealStats = Boolean(statAlumni || statCities || statSatisfaction || statBatches);

const waNumber = settingsMap['whatsapp_number'] || '';
const waUrl = waNumber 
  ? `https://wa.me/${waNumber.replace(/[^0-9]/g, '')}` 
  : 'https://wa.me/628123456789';

function getDayNum(dateStr: string) {
  try {
    return new Date(dateStr).toLocaleDateString('id-ID', { timeZone: 'Asia/Jakarta', day: 'numeric' });
  } catch {
    return '';
  }
}

function getMonthShort(dateStr: string) {
  try {
    return new Date(dateStr).toLocaleDateString('id-ID', { timeZone: 'Asia/Jakarta', month: 'short' }).toUpperCase();
  } catch {
    return '';
  }
}
---

<PublicLayout
  title="Happy Couple Class — Tempat Belajar Mencintai dengan Ilmu"
  description="Happy Couple Class adalah kelas pernikahan berbasis Islam yang membekali pasangan dengan ilmu syariat, komunikasi suami istri, dan panduan keluarga sakinah."
>

  <!-- =================== 1. HERO =================== -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <!-- Kiri: Teks -->
        <div class="hero-content">
          <div class="hero-eyebrow">
            <span class="material-symbols-outlined" aria-hidden="true">favorite</span>
            <span>Kelas Pernikahan Berbasis Islam</span>
          </div>
          <h1 class="hero-title">
            Tempat belajar <em class="hero-italic">mencintai</em><br />dengan ilmu
          </h1>
          <p class="hero-desc">
            Belajar pernikahan yang sebenarnya bukan hanya soal menikah, melainkan
            tentang bagaimana menjadi pasangan yang saling mendukung menuju surga.
            Karena cinta terbaik adalah cinta yang dilandasi ilmu dan takwa.
          </p>
          <div class="hero-actions">
            <a href="#event" class="btn btn-primary btn-lg">
              <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
              Lihat Jadwal Kelas
            </a>
            <a href="#tentang" class="btn btn-outline btn-lg">Tentang Kami</a>
          </div>

          {hasRealStats && (
            <div class="hero-stats">
              {statAlumni && (
                <div class="stat-item">
                  <span class="stat-val">{statAlumni}</span>
                  <span class="stat-lbl">Alumni Couple</span>
                </div>
              )}
              {statCities && (
                <div class="stat-item">
                  <span class="stat-val">{statCities}</span>
                  <span class="stat-lbl">Kota &amp; Daerah</span>
                </div>
              )}
              {statBatches && (
                <div class="stat-item">
