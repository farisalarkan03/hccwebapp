                  <span class="stat-lbl">Batch Terlaksana</span>
                </div>
              )}
              {statSatisfaction && (
                <div class="stat-item">
                  <span class="stat-val">{statSatisfaction}</span>
                  <span class="stat-lbl">Tingkat Kepuasan</span>
                </div>
