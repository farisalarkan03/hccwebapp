      ) : (
        <div class="events-3col-grid">
          {activeEvents.map((ev) => (
            <article class="event-poster-card">
              <!-- Top: Flyer Preview 4x5 Vertikal -->
              <a href={`/event/${ev.slug}`} class="poster-img-wrap" aria-label={`Detail ${ev.title}`}>
                {ev.flyer_url ? (
                  <img
