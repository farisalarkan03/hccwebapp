              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary btn-lg"
            >
              <span class="material-symbols-outlined" aria-hidden="true">chat</span>
              Tanya via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</PublicLayout>

<script>
  // YouTube Facade activation
  const facade = document.getElementById('yt-facade');
  const playBtn = document.getElementById('facade-play-btn');

  function loadYouTubeIframe() {
    if (!facade) return;
    const vidId = facade.getAttribute('data-video-id') || 'n2gCH72CH_8';
    facade.innerHTML = `
      <iframe
        src="https://www.youtube.com/embed/${vidId}?autoplay=1&rel=0&modestbranding=1"
        title="Suasana Happy Couple Class bersama Kak Suhe"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; border-radius: inherit;"
      ></iframe>
    `;
    facade.classList.add('is-playing');
  }

  if (facade && playBtn) {
    playBtn.addEventListener('click', loadYouTubeIframe);
    facade.addEventListener('click', (e) => {
      if (e.target !== playBtn && !facade.classList.contains('is-playing')) {
        loadYouTubeIframe();
      }
    });
  }
</script>

