          <div class="hero-card-backdrop" aria-hidden="true"></div>
          <div class="hero-photo-card">
            <img
              src="/img/hero-couple.jpg"
              alt="Suasana kelas pernikahan islami Happy Couple Class"
              class="hero-photo"
              width="480"
              height="600"
              loading="eager"
            />
          </div>
        </div>
