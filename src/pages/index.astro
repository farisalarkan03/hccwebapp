                    <span class="poster-price-lbl">Harga per couple</span>
                    <strong class="poster-price-val">{formatRupiah(ev.price_per_couple)}</strong>
                  </div>
                  <div class="poster-btn-group">
                    <a href={`/event/${ev.slug}`} class="btn-card-detail">
                      Detail
                    </a>
                    <a href={`/daftar/${ev.slug}`} class="btn btn-primary btn-sm btn-card-daftar">
                      Daftar
