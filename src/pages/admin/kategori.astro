---
export const prerender = false;

import { requireAdmin } from '../../lib/auth';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createServiceClient } from '../../lib/supabase';
import { slugify } from '../../lib/format';

const authResult = await requireAdmin(Astro);
if (authResult instanceof Response) return authResult;

const { admin } = authResult;
const supabase = createServiceClient();

let message = '';
let errorMessage = '';

// Handle form submissions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action') as string;

    if (action === 'create') {
      const name = (formData.get('name') as string)?.trim();
      const sortOrder = parseInt(formData.get('sort_order') as string) || 0;
      const slug = (formData.get('slug') as string)?.trim() || slugify(name);

      if (!name) throw new Error('Nama kategori tidak boleh kosong.');

      const { error } = await supabase.from('categories').insert({
        name,
        slug,
        sort_order: sortOrder,
      });

      if (error) {
        if (error.code === '23505') throw new Error('Slug kategori sudah digunakan.');
        throw error;
      }
      message = 'Kategori berhasil ditambahkan.';
    } else if (action === 'update') {
      const id = formData.get('id') as string;
      const name = (formData.get('name') as string)?.trim();
      const slug = (formData.get('slug') as string)?.trim();
      const sortOrder = parseInt(formData.get('sort_order') as string) || 0;

      if (!id || !name) throw new Error('Data kategori tidak lengkap.');

      const { error } = await supabase
        .from('categories')
        .update({ name, slug, sort_order: sortOrder })
        .eq('id', id);

      if (error) throw error;
      message = 'Kategori berhasil diperbarui.';
    } else if (action === 'delete') {
      const id = formData.get('id') as string;
      if (!id) throw new Error('ID kategori tidak valid.');

      // Check if any events use this category
      const { count } = await supabase
        .from('events')
        .select('id', { count: 'exact', head: true })
        .eq('category_id', id)
        .is('deleted_at', null);

      if (count && count > 0) {
        throw new Error(`Tidak dapat menghapus. Ada ${count} event yang masih terhubung dengan kategori ini.`);
      }

      const { error } = await supabase.from('categories').delete().eq('id', id);
      if (error) throw error;
      message = 'Kategori berhasil dihapus.';
    }
  } catch (err: any) {
    errorMessage = err.message || 'Terjadi kesalahan memproses kategori.';
  }
}

// Fetch all categories with event counts
const { data: categoriesList } = await supabase
  .from('categories')
  .select('id, name, slug, sort_order, created_at')
  .order('sort_order', { ascending: true })
  .order('name', { ascending: true });

const categories = categoriesList || [];
---

<AdminLayout title="Kategori Event" adminName={admin.name} adminRole={admin.role}>
  <div class="kategori-container">
    <!-- Header -->
    <div class="page-header">
      <div>
        <h2 class="page-title">Kelola Kategori</h2>
        <p class="page-desc">Kelompokkan kelas berdasarkan tema (misal: Pranikah, Pascanikah, Parenting).</p>
      </div>
      <button type="button" class="btn btn-primary btn-sm" id="btn-add-kategori">
        <span class="material-symbols-outlined" aria-hidden="true">add</span>
        Tambah Kategori
      </button>
    </div>

    {message && (
      <div class="alert alert-success" role="alert">
        <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
        <span>{message}</span>
      </div>
    )}

    {errorMessage && (
      <div class="alert alert-danger" role="alert">
        <span class="material-symbols-outlined" aria-hidden="true">error</span>
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Table Card -->
    <div class="card table-card">
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 80px;">Urutan</th>
              <th>Nama Kategori</th>
              <th>Slug</th>
              <th class="text-right" style="width: 140px;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            {categories.length === 0 ? (
              <tr>
                <td colspan="4">
                  <div class="empty-state">
                    <span class="material-symbols-outlined empty-icon" aria-hidden="true">category</span>
                    <p class="empty-title">Belum ada kategori</p>
                    <p class="empty-desc">Klik "Tambah Kategori" di atas untuk menambahkan kategori pertama.</p>
                  </div>
                </td>
              </tr>
            ) : (
              categories.map((cat) => (
                <tr>
                  <td>
                    <span class="sort-order-badge">{cat.sort_order}</span>
                  </td>
                  <td>
                    <strong class="cat-name">{cat.name}</strong>
                  </td>
                  <td>
                    <code class="cat-slug">{cat.slug}</code>
                  </td>
                  <td class="text-right">
                    <div class="action-buttons">
                      <button
                        type="button"
                        class="btn-icon btn-edit-cat"
                        data-id={cat.id}
                        data-name={cat.name}
                        data-slug={cat.slug}
                        data-sort={cat.sort_order}
                        aria-label={`Ubah kategori ${cat.name}`}
                      >
                        <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                      </button>
                      <form method="POST" style="display: inline;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus kategori ini?');">
                        <input type="hidden" name="_action" value="delete" />
                        <input type="hidden" name="id" value={cat.id} />
                        <button type="submit" class="btn-icon btn-delete" aria-label={`Hapus kategori ${cat.name}`}>
                          <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Form (Add / Edit) -->
    <div id="cat-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card">
        <div class="modal-header">
          <h3 id="modal-title" class="modal-title">Tambah Kategori</h3>
          <button type="button" id="modal-close" class="modal-close-btn" aria-label="Tutup modal">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
        </div>
        <form method="POST" id="cat-form" class="modal-body">
          <input type="hidden" name="_action" id="form-action" value="create" />
          <input type="hidden" name="id" id="form-id" value="" />

          <div class="form-group">
            <label for="name" class="form-label">Nama Kategori <span class="required">*</span></label>
            <input
              type="text"
              id="cat-name-input"
              name="name"
              class="form-input"
              placeholder="Contoh: Pranikah Akbar"
              required
            />
          </div>

          <div class="form-group">
            <label for="slug" class="form-label">Slug URL</label>
            <input
              type="text"
              id="cat-slug-input"
              name="slug"
              class="form-input"
              placeholder="pranikah-akbar (otomatis jika dikosongkan)"
            />
          </div>

          <div class="form-group">
            <label for="sort_order" class="form-label">Urutan Tampil</label>
            <input
              type="number"
              id="cat-sort-input"
              name="sort_order"
              class="form-input"
              value="0"
              min="0"
            />
            <span class="form-help">Angka lebih kecil tampil lebih awal.</span>
          </div>

          <div class="modal-footer">
            <button type="button" id="modal-cancel" class="btn btn-secondary btn-sm">Batal</button>
            <button type="submit" class="btn btn-primary btn-sm">Simpan</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const modal = document.getElementById('cat-modal');
  const btnAdd = document.getElementById('btn-add-kategori');
  const btnClose = document.getElementById('modal-close');
  const btnCancel = document.getElementById('modal-cancel');
  const form = document.getElementById('cat-form') as HTMLFormElement;
  const modalTitle = document.getElementById('modal-title');
  const formAction = document.getElementById('form-action') as HTMLInputElement;
  const formId = document.getElementById('form-id') as HTMLInputElement;
  const nameInput = document.getElementById('cat-name-input') as HTMLInputElement;
  const slugInput = document.getElementById('cat-slug-input') as HTMLInputElement;
  const sortInput = document.getElementById('cat-sort-input') as HTMLInputElement;

  function openModal(isEdit = false, data?: any) {
    if (modal) modal.style.display = 'flex';
    if (isEdit && data) {
      if (modalTitle) modalTitle.textContent = 'Ubah Kategori';
      if (formAction) formAction.value = 'update';
      if (formId) formId.value = data.id;
      if (nameInput) nameInput.value = data.name;
      if (slugInput) slugInput.value = data.slug;
      if (sortInput) sortInput.value = data.sort;
    } else {
      if (modalTitle) modalTitle.textContent = 'Tambah Kategori';
      if (formAction) formAction.value = 'create';
      if (formId) formId.value = '';
      if (form) form.reset();
      if (sortInput) sortInput.value = '0';
    }
  }

  function closeModal() {
    if (modal) modal.style.display = 'none';
  }

  btnAdd?.addEventListener('click', () => openModal(false));
  btnClose?.addEventListener('click', closeModal);
  btnCancel?.addEventListener('click', closeModal);

  // Auto slug generator on type if slug is empty or user is creating
  nameInput?.addEventListener('input', () => {
    if (formAction.value === 'create') {
      const generated = nameInput.value
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');
      slugInput.value = generated;
    }
  });

  // Edit button listeners
  document.querySelectorAll('.btn-edit-cat').forEach((btn) => {
    btn.addEventListener('click', () => {
      const data = {
        id: btn.getAttribute('data-id'),
        name: btn.getAttribute('data-name'),
        slug: btn.getAttribute('data-slug'),
        sort: btn.getAttribute('data-sort'),
      };
      openModal(true, data);
    });
  });
</script>

<style>
  .kategori-container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .page-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 4px 0;
  }

  .page-desc {
    font-size: 14px;
    color: var(--ink-600);
    margin: 0;
  }

  .alert {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    font-size: 14px;
  }

  .alert-success {
    background: var(--ok-bg);
    color: var(--ok);
    border: 1px solid rgba(46, 158, 107, 0.2);
  }

  .alert-danger {
    background: var(--danger-bg);
    color: var(--danger);
    border: 1px solid rgba(214, 69, 69, 0.2);
  }

  .table-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .data-table th {
    text-align: left;
    padding: 14px 18px;
    background: var(--pink-50);
    color: var(--ink-600);
    font-weight: 500;
    font-size: 13px;
    border-bottom: 1px solid var(--line);
  }

  .data-table td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  .data-table tr:last-child td { border-bottom: none; }
  .data-table tr:hover td { background-color: #fcf9fa; }

  .sort-order-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: #f0edf0;
    color: var(--ink-900);
    font-size: 12px;
    font-weight: 600;
  }

  .cat-name {
    color: var(--ink-900);
    font-size: 14px;
  }

  .cat-slug {
    font-family: monospace;
    font-size: 12px;
    color: var(--ink-600);
    background: var(--pink-50);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .action-buttons {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .btn-icon {
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-600);
    cursor: pointer;
    transition: all 150ms ease;
  }

  .btn-icon:hover {
    background: var(--pink-50);
    color: var(--pink-500);
    border-color: var(--pink-200);
  }

  .btn-delete:hover {
    color: var(--danger);
    background: var(--danger-bg);
    border-color: rgba(214, 69, 69, 0.3);
  }

  .btn-icon .material-symbols-outlined {
    font-size: 18px;
  }

  .text-right { text-align: right; }

  /* Modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(31, 26, 29, 0.45);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .modal-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 480px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .modal-header {
    padding: 18px 24px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0;
  }

  .modal-close-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-400);
    padding: 4px;
    display: flex;
  }

  .modal-close-btn:hover { color: var(--ink-900); }

  .modal-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-900);
  }

  .required { color: var(--danger); }

  .form-input {
    height: 42px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 150ms ease;
  }

  .form-input:focus {
    border-color: var(--pink-400);
    box-shadow: 0 0 0 3px var(--pink-100);
  }

  .form-help {
    font-size: 11px;
    color: var(--ink-400);
  }

  .modal-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 40px 16px;
  }
  .empty-icon { font-size: 40px; color: var(--ink-400); margin-bottom: 8px; }
  .empty-title { font-size: 15px; font-weight: 600; color: var(--ink-900); margin: 0 0 4px 0; }
  .empty-desc { font-size: 13px; color: var(--ink-600); margin: 0; }
</style>
