---
export const prerender = false;

import { requireAdmin } from '../../../lib/auth';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServiceClient } from '../../../lib/supabase';
import { slugify, parseWIBInputToISO } from '../../../lib/format';

const authResult = await requireAdmin(Astro);
if (authResult instanceof Response) return authResult;

const { admin } = authResult;
const supabase = createServiceClient();

let errorMessage = '';

// Handle POST
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();

    const title = (formData.get('title') as string)?.trim();
    let slug = (formData.get('slug') as string)?.trim() || slugify(title);
    const categoryId = (formData.get('category_id') as string) || null;
    const dateStart = formData.get('date_start') as string;
    const dateEnd = (formData.get('date_end') as string) || null;
    const location = (formData.get('location') as string)?.trim();
    const locationMapUrl = (formData.get('location_map_url') as string)?.trim() || null;
    const pricePerCouple = parseFloat(formData.get('price_per_couple') as string) || 0;
    const quotaStr = formData.get('quota') as string;
    const quota = quotaStr ? parseInt(quotaStr) : null;
    const flyerUrl = (formData.get('flyer_url') as string)?.trim() || null;
    const description = (formData.get('description') as string)?.trim() || null;

    // Accounts & confirmators
    const paymentAccountIds = formData.getAll('payment_accounts') as string[];
    const confirmatorIds = formData.getAll('confirmators') as string[];
    const primaryConfirmatorId = formData.get('primary_confirmator') as string;

    if (!title) throw new Error('Judul event wajib diisi.');
    if (!dateStart) throw new Error('Tanggal mulai wajib diisi.');
    if (!location) throw new Error('Lokasi pelaksanaan wajib diisi.');

    // 1. Insert event
    const { data: newEvent, error: insertError } = await supabase
      .from('events')
      .insert({
        title,
        slug,
        category_id: categoryId,
        date_start: parseWIBInputToISO(dateStart)!,
        date_end: parseWIBInputToISO(dateEnd),
        location,
        location_map_url: locationMapUrl,
        price_per_couple: pricePerCouple,
        quota,
        flyer_url: flyerUrl,
        description,
        status: 'draft',
        waitlist_enabled: false,
        allow_duplicate_wa: false,
        payment_deadline_hours: 24,
        show_on_landing: true,
      })
      .select('id')
      .single();

    if (insertError) {
      if (insertError.code === '23505') throw new Error('Slug URL sudah dipakai oleh event lain.');
      throw insertError;
    }

    const eventId = newEvent.id;

    // 2. Insert payment accounts
    if (paymentAccountIds.length > 0) {
      const pRows = paymentAccountIds.map((accId) => ({
        event_id: eventId,
        payment_account_id: accId,
      }));
      await supabase.from('event_payment_accounts').insert(pRows);
    }

    // 3. Insert confirmators
    if (confirmatorIds.length > 0) {
      const cRows = confirmatorIds.map((admId) => ({
        event_id: eventId,
        admin_id: admId,
        is_primary: admId === primaryConfirmatorId || (confirmatorIds.length === 1),
      }));
      await supabase.from('event_confirmators').insert(cRows);
    } else {
      // Default to current admin as primary
      await supabase.from('event_confirmators').insert({
        event_id: eventId,
        admin_id: admin.id,
        is_primary: true,
      });
    }

    // Redirect directly to Form Builder as required by the specification
    return Astro.redirect(`/admin/events/${eventId}/form`);
  } catch (err: any) {
    errorMessage = err.message || 'Terjadi kesalahan menyimpan event.';
  }
}

// Fetch categories
const { data: categories } = await supabase
  .from('categories')
  .select('id, name')
  .order('sort_order', { ascending: true });

// Fetch active payment accounts
const { data: paymentAccounts } = await supabase
  .from('payment_accounts')
  .select('id, bank_name, account_number, account_name')
  .eq('is_active', true)
  .order('bank_name', { ascending: true });

// Fetch active admins
const { data: adminsList } = await supabase
  .from('admins')
  .select('id, name, whatsapp')
  .eq('is_active', true)
  .order('name', { ascending: true });
---

<AdminLayout title="Tambah Kelas Baru" adminName={admin.name} adminRole={admin.role}>
  <div class="form-container">
    <div class="page-header">
      <div>
        <div class="breadcrumb">
          <a href="/admin/events">Event</a>
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
          <span>Tambah Kelas Baru</span>
        </div>
        <h2 class="page-title">Buat Kelas Baru</h2>
        <p class="page-desc">Isi data dasar kelas, lalu Anda akan langsung diarahkan ke Form Builder untuk menyusun formulir pendaftaran.</p>
      </div>
    </div>

    {errorMessage && (
      <div class="alert alert-danger" role="alert">
        <span class="material-symbols-outlined" aria-hidden="true">error</span>
        <span>{errorMessage}</span>
      </div>
    )}

    <form method="POST" class="event-form">
      <!-- Section: Informasi Utama -->
      <div class="form-card">
        <h3 class="form-section-title">
          <span class="material-symbols-outlined" aria-hidden="true">event_note</span>
          Informasi Utama
        </h3>

        <div class="form-grid">
          <div class="form-group col-span-2">
            <label for="title" class="form-label">Judul Kelas / Event <span class="required">*</span></label>
            <input
              type="text"
              id="title"
              name="title"
              class="form-input"
              placeholder="Contoh: Happy Couple Class Batch 12 - Menuju Sakinah"
              required
            />
          </div>

          <div class="form-group col-span-2">
            <label for="slug" class="form-label">Slug URL Halaman <span class="required">*</span></label>
            <div class="slug-input-wrap">
              <span class="slug-prefix">happycoupleclass.com/event/</span>
              <input
                type="text"
                id="slug"
                name="slug"
                class="form-input slug-input"
                placeholder="batch-12-sakinah"
                required
              />
            </div>
            <span class="form-help">Dibuat otomatis dari judul, dapat Anda sesuaikan.</span>
          </div>

          <div class="form-group">
            <label for="category_id" class="form-label">Kategori</label>
            <select id="category_id" name="category_id" class="form-select">
              <option value="">-- Pilih Kategori --</option>
              {categories?.map((cat) => (
                <option value={cat.id}>{cat.name}</option>
              ))}
            </select>
          </div>

          <div class="form-group">
            <label for="price_per_couple" class="form-label">Harga Pendaftaran (per Couple) <span class="required">*</span></label>
            <div class="price-input-wrap">
              <span class="price-prefix">Rp</span>
              <input
                type="number"
                id="price_per_couple"
                name="price_per_couple"
                class="form-input price-input"
                placeholder="250000"
                min="0"
                step="1000"
                required
              />
            </div>
            <span class="form-help">Biaya untuk 1 couple (suami &amp; istri).</span>
          </div>

          <div class="form-group">
            <label for="date_start" class="form-label">Tanggal &amp; Waktu Mulai <span class="required">*</span></label>
            <input
              type="datetime-local"
              id="date_start"
              name="date_start"
              class="form-input"
              required
            />
          </div>

          <div class="form-group">
            <label for="date_end" class="form-label">Tanggal &amp; Waktu Selesai</label>
            <input
              type="datetime-local"
              id="date_end"
              name="date_end"
              class="form-input"
            />
          </div>

          <div class="form-group">
            <label for="location" class="form-label">Lokasi Pelaksanaan <span class="required">*</span></label>
            <input
              type="text"
              id="location"
              name="location"
              class="form-input"
              placeholder="Contoh: Ballroom Hotel Santika Bandung"
              required
            />
          </div>

          <div class="form-group">
            <label for="location_map_url" class="form-label">Link Google Maps</label>
            <input
              type="url"
              id="location_map_url"
              name="location_map_url"
              class="form-input"
              placeholder="https://maps.app.goo.gl/..."
            />
          </div>

          <div class="form-group">
            <label for="quota" class="form-label">Kuota Peserta (Couple)</label>
            <input
              type="number"
              id="quota"
              name="quota"
              class="form-input"
              placeholder="Kosongkan jika kuota tidak dibatasi"
              min="1"
            />
          </div>

          <div class="form-group col-span-2">
            <div class="flyer-label-row">
              <label class="form-label" for="flyer_file_input">
                Flyer / Banner Event
              </label>
              <span class="label-badge-compress">
                <span class="material-symbols-outlined badge-icon" aria-hidden="true">auto_fix_high</span>
                Auto Kompres WebP
              </span>
            </div>

            <!-- Hidden input that holds the final URL saved into database -->
            <input
              type="hidden"
              id="flyer_url"
              name="flyer_url"
              value=""
            />

            <!-- Upload Container -->
            <div class="flyer-uploader-box">
              <!-- Dropzone -->
              <div class="flyer-dropzone" id="flyer-dropzone">
                <input
                  type="file"
                  id="flyer_file_input"
                  accept="image/jpeg,image/png,image/webp,image/jpg"
                  class="flyer-file-input"
                />
                <div class="dropzone-body">
                  <div class="dropzone-icon-circle">
                    <span class="material-symbols-outlined" aria-hidden="true">cloud_upload</span>
                  </div>
                  <div class="dropzone-text-group">
                    <p class="dropzone-main-text">
                      <strong>Klik untuk pilih file</strong> atau seret gambar flyer ke sini
                    </p>
                    <p class="dropzone-sub-text">
                      JPG, PNG, atau WebP. Gambar otomatis di-resize (maks. 1200px) &amp; dikompres ke WebP agar hemat ruang penyimpanan.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Upload Progress / Compression Status -->
              <div class="flyer-status-bar" id="flyer-status-bar" style="display: none;">
                <div class="status-spinner"></div>
                <div class="status-info">
                  <strong id="flyer-status-title">Memproses gambar...</strong>
                  <span id="flyer-status-detail">Mengompresi ke WebP beresolusi optimal...</span>
                </div>
              </div>

              <!-- Preview Card (shown when an image is ready) -->
              <div class="flyer-preview-card" id="flyer-preview-card" style="display: none;">
                <div class="preview-thumbnail-wrap">
                  <img id="flyer-preview-img" src="" alt="Preview Flyer" class="preview-thumbnail" />
                </div>
                <div class="preview-details">
                  <div class="preview-title-row">
                    <span class="material-symbols-outlined icon-verified" aria-hidden="true">check_circle</span>
                    <strong class="preview-title">Flyer Siap Digunakan</strong>
                  </div>
                  <div class="compression-stats" id="compression-stats">
                    <span class="stat-pill" id="stat-pill-savings">-</span>
                    <span class="stat-pill-gray" id="stat-pill-size">-</span>
                  </div>
                  <p class="preview-url-text" id="preview-url-text"></p>
                  <div class="preview-actions">
                    <button type="button" class="btn-action-outline" id="btn-reupload-flyer">
                      <span class="material-symbols-outlined" aria-hidden="true">sync</span>
                      Ganti Gambar
                    </button>
                    <button type="button" class="btn-action-danger" id="btn-delete-flyer">
                      <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                      Hapus
                    </button>
                  </div>
                </div>
              </div>

              <!-- Manual URL Toggle -->
              <div class="manual-url-container">
                <button type="button" class="btn-text-toggle" id="btn-toggle-manual">
                  <span class="material-symbols-outlined" aria-hidden="true">link</span>
                  <span>Atau gunakan tautan URL gambar langsung</span>
                </button>
                <div class="manual-url-form" id="manual-url-form" style="display: none;">
                  <div class="manual-url-input-group">
                    <input
                      type="url"
                      id="manual_flyer_url"
                      class="form-input"
                      placeholder="https://domain.com/gambar-flyer.jpg"
                    />
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-apply-manual-url">
                      Gunakan URL
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-group col-span-2">
            <label for="description" class="form-label">Deskripsi Ringkas</label>
            <textarea
              id="description"
              name="description"
              class="form-textarea"
              rows="3"
              placeholder="Jelaskan tema, narasumber, dan manfaat yang didapatkan peserta..."
            ></textarea>
          </div>
        </div>
      </div>

      <!-- Section: Rekening Pembayaran -->
      <div class="form-card">
        <div class="card-title-between">
          <h3 class="form-section-title">
            <span class="material-symbols-outlined" aria-hidden="true">payments</span>
            Pilih Rekening Pembayaran
          </h3>
          <a href="/admin/pengaturan" target="_blank" class="card-sublink">
            Kelola Rekening
            <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
          </a>
        </div>
        <p class="form-card-desc">Centang rekening yang aktif untuk menerima transfer dari pendaftar event ini.</p>

        {(!paymentAccounts || paymentAccounts.length === 0) ? (
          <div class="empty-inline">
            <span>Belum ada rekening pembayaran aktif. Silakan tambah rekening di Pengaturan.</span>
          </div>
        ) : (
          <div class="checkbox-grid">
            {paymentAccounts.map((acc) => (
              <label class="checkbox-card">
                <input
                  type="checkbox"
                  name="payment_accounts"
                  value={acc.id}
                  class="custom-checkbox"
                  checked
                />
                <div class="checkbox-card-content">
                  <strong>{acc.bank_name}</strong>
                  <span class="acc-num">{acc.account_number}</span>
                  <span class="acc-holder">a.n {acc.account_name}</span>
                </div>
              </label>
            ))}
          </div>
        )}
      </div>

      <!-- Section: Admin Konfirmator -->
      <div class="form-card">
        <h3 class="form-section-title">
          <span class="material-symbols-outlined" aria-hidden="true">support_agent</span>
          Admin Konfirmator WhatsApp
        </h3>
        <p class="form-card-desc">Pilih admin yang akan menerima pesan konfirmasi WhatsApp dan verifikasi transfer dari peserta.</p>

        <div class="confirmators-list">
          {adminsList?.map((adm) => (
            <div class="confirmator-row">
              <label class="checkbox-inline">
                <input
                  type="checkbox"
                  name="confirmators"
                  value={adm.id}
                  checked={adm.id === admin.id}
                />
                <span><strong>{adm.name}</strong> ({adm.whatsapp})</span>
              </label>

              <label class="radio-inline">
                <input
                  type="radio"
                  name="primary_confirmator"
                  value={adm.id}
                  checked={adm.id === admin.id}
                />
                <span>Konfirmator Utama</span>
              </label>
            </div>
          ))}
        </div>
      </div>

      <!-- Submit Actions -->
      <div class="form-actions-card">
        <a href="/admin/events" class="btn btn-secondary btn-md">Batal</a>
        <button type="submit" class="btn btn-primary btn-md">
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          Simpan &amp; Lanjut ke Form Builder
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const titleInput = document.getElementById('title') as HTMLInputElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;

  titleInput?.addEventListener('input', () => {
    const slug = titleInput.value
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/[\s_-]+/g, '-')
      .replace(/^-+|-+$/g, '');
    if (slugInput) slugInput.value = slug;
  });

  // --- Flyer Upload & Auto Compression Logic ---
  const fileInput = document.getElementById('flyer_file_input') as HTMLInputElement;
  const dropzone = document.getElementById('flyer-dropzone') as HTMLDivElement;
  const statusBar = document.getElementById('flyer-status-bar') as HTMLDivElement;
  const statusTitle = document.getElementById('flyer-status-title') as HTMLElement;
  const statusDetail = document.getElementById('flyer-status-detail') as HTMLElement;
  const previewCard = document.getElementById('flyer-preview-card') as HTMLDivElement;
  const previewImg = document.getElementById('flyer-preview-img') as HTMLImageElement;
  const statSavings = document.getElementById('stat-pill-savings') as HTMLElement;
  const statSize = document.getElementById('stat-pill-size') as HTMLElement;
  const previewUrlText = document.getElementById('preview-url-text') as HTMLElement;
  const hiddenFlyerUrl = document.getElementById('flyer_url') as HTMLInputElement;
  const btnReupload = document.getElementById('btn-reupload-flyer') as HTMLButtonElement;
  const btnDelete = document.getElementById('btn-delete-flyer') as HTMLButtonElement;
  const btnToggleManual = document.getElementById('btn-toggle-manual') as HTMLButtonElement;
  const manualForm = document.getElementById('manual-url-form') as HTMLDivElement;
  const manualInput = document.getElementById('manual_flyer_url') as HTMLInputElement;
  const btnApplyManual = document.getElementById('btn-apply-manual-url') as HTMLButtonElement;
  const mainForm = document.querySelector('.event-form') as HTMLFormElement;

  let isUploading = false;

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    const kb = bytes / 1024;
    if (kb < 1024) return kb.toFixed(1) + ' KB';
    return (kb / 1024).toFixed(2) + ' MB';
  }

  // Compress image client-side via HTML5 Canvas
  async function compressImageFile(file: File): Promise<{ blob: Blob; originalSize: number; compressedSize: number }> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const maxDim = 1200;
          let width = img.width;
          let height = img.height;

          if (width > height) {
            if (width > maxDim) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            }
          } else {
            if (height > maxDim) {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }

          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            return reject(new Error('Canvas context tidak tersedia.'));
          }
          ctx.drawImage(img, 0, 0, width, height);

          // Compress to WebP with 0.82 quality
          canvas.toBlob(
            (blob) => {
              if (blob) {
                resolve({
                  blob,
                  originalSize: file.size,
                  compressedSize: blob.size,
                });
              } else {
                // Fallback to JPEG if browser doesn't support WebP export
                canvas.toBlob(
                  (jpegBlob) => {
                    if (jpegBlob) {
                      resolve({
                        blob: jpegBlob,
                        originalSize: file.size,
                        compressedSize: jpegBlob.size,
                      });
                    } else {
                      reject(new Error('Gagal mengompres gambar.'));
                    }
                  },
                  'image/jpeg',
                  0.82
                );
              }
            },
            'image/webp',
            0.82
          );
        };
        img.onerror = () => reject(new Error('File bukan gambar yang valid.'));
        img.src = e.target?.result as string;
      };
      reader.onerror = () => reject(new Error('Gagal membaca file gambar.'));
      reader.readAsDataURL(file);
    });
  }

  async function handleFlyerSelected(file: File) {
    if (!file || !file.type.startsWith('image/')) {
      alert('Mohon pilih file gambar (JPG, PNG, atau WebP).');
      return;
    }

    try {
      isUploading = true;
      if (dropzone) dropzone.style.display = 'none';
      if (previewCard) previewCard.style.display = 'none';
      if (statusBar) statusBar.style.display = 'flex';
      if (statusTitle) statusTitle.textContent = 'Mengompresi gambar...';
      if (statusDetail) statusDetail.textContent = `Ukuran asli: ${formatBytes(file.size)}. Mengoptimalkan ukuran...`;

      // 1. Client-side compression
      const { blob, originalSize, compressedSize } = await compressImageFile(file);
      const savedPercent = Math.max(0, Math.round(((originalSize - compressedSize) / originalSize) * 100));

      if (statusTitle) statusTitle.textContent = 'Mengunggah flyer ke server...';
      if (statusDetail) statusDetail.textContent = `WebP teroptimasi (${formatBytes(compressedSize)} — hemat ${savedPercent}%). Mengunggah...`;

      // 2. Upload via API
      const formData = new FormData();
      const cleanFileName = (file.name.replace(/\.[^/.]+$/, '') || 'flyer') + '.webp';
      formData.append('file', blob, cleanFileName);

      const res = await fetch('/api/admin/upload', {
        method: 'POST',
        body: formData,
      });

      const json = await res.json();
      if (!res.ok) {
        throw new Error(json.error || 'Gagal mengunggah file flyer.');
      }

      // 3. Update UI
      const finalUrl = json.url;
      if (hiddenFlyerUrl) hiddenFlyerUrl.value = finalUrl;
      if (previewImg) previewImg.src = finalUrl;
      if (previewUrlText) previewUrlText.textContent = finalUrl;
      if (statSavings) statSavings.textContent = `Hemat ${savedPercent}% (${formatBytes(compressedSize)})`;
      if (statSize) statSize.textContent = `Asli: ${formatBytes(originalSize)}`;

      if (statusBar) statusBar.style.display = 'none';
      if (previewCard) previewCard.style.display = 'flex';
      if (dropzone) dropzone.style.display = 'none';
    } catch (err: any) {
      alert(err.message || 'Terjadi kesalahan saat mengompres/mengunggah gambar.');
      if (statusBar) statusBar.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
      if (hiddenFlyerUrl) hiddenFlyerUrl.value = '';
    } finally {
      isUploading = false;
      if (fileInput) fileInput.value = '';
    }
  }

  fileInput?.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) {
      handleFlyerSelected(fileInput.files[0]);
    }
  });

  // Drag and drop handlers
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('dropzone-active');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('dropzone-active');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dropzone-active');
    if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
      handleFlyerSelected(e.dataTransfer.files[0]);
    }
  });

  btnReupload?.addEventListener('click', () => {
    fileInput?.click();
  });

  btnDelete?.addEventListener('click', () => {
    if (confirm('Hapus gambar flyer ini?')) {
      if (hiddenFlyerUrl) hiddenFlyerUrl.value = '';
      if (previewImg) previewImg.src = '';
      if (previewUrlText) previewUrlText.textContent = '';
      if (previewCard) previewCard.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }
  });

  btnToggleManual?.addEventListener('click', () => {
    if (manualForm) {
      const isHidden = manualForm.style.display === 'none';
      manualForm.style.display = isHidden ? 'block' : 'none';
    }
  });

  btnApplyManual?.addEventListener('click', () => {
    const val = manualInput?.value.trim();
    if (!val) {
      alert('Masukkan URL gambar.');
      return;
    }
    if (hiddenFlyerUrl) hiddenFlyerUrl.value = val;
    if (previewImg) previewImg.src = val;
    if (previewUrlText) previewUrlText.textContent = val;
    if (statSavings) statSavings.textContent = 'URL Eksternal';
    if (statSize) statSize.textContent = '-';
    if (dropzone) dropzone.style.display = 'none';
    if (statusBar) statusBar.style.display = 'none';
    if (previewCard) previewCard.style.display = 'flex';
  });

  // Prevent form submission if upload is still in progress
  mainForm?.addEventListener('submit', (e) => {
    if (isUploading) {
      e.preventDefault();
      alert('Sedang mengunggah flyer, mohon tunggu hingga proses selesai.');
    }
  });
</script>

