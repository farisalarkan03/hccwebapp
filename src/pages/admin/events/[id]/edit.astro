        </div>
      </div>
      <form method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus event ini? Event tidak akan muncul lagi di website.');">
        <input type="hidden" name="_action" value="delete_event" />
        <button type="submit" class="btn btn-danger btn-sm">
          <span class="material-symbols-outlined" aria-hidden="true">delete</span>
          Hapus Event Ini
        </button>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  // Copy Event ID
  const btnCopyId = document.getElementById('btn-copy-id');
  const eventIdText = document.getElementById('event-id-text')?.textContent;
  btnCopyId?.addEventListener('click', async () => {
    if (eventIdText) {
      await navigator.clipboard.writeText(eventIdText);
      alert('ID Event disalin ke clipboard!');
    }
  });

  // Copy Generated Password
  const btnCopyPass = document.getElementById('btn-copy-pass');
  btnCopyPass?.addEventListener('click', async () => {
    const pass = btnCopyPass.getAttribute('data-pass');
    if (pass) {
      await navigator.clipboard.writeText(pass);
      alert('Password scanner berhasil disalin!');
    }
  });

  // --- Flyer Upload & Auto Compression Logic ---
  const fileInput = document.getElementById('flyer_file_input') as HTMLInputElement;
  const dropzone = document.getElementById('flyer-dropzone') as HTMLDivElement;
  const statusBar = document.getElementById('flyer-status-bar') as HTMLDivElement;
  const statusTitle = document.getElementById('flyer-status-title') as HTMLElement;
  const statusDetail = document.getElementById('flyer-status-detail') as HTMLElement;
  const previewCard = document.getElementById('flyer-preview-card') as HTMLDivElement;
  const previewImg = document.getElementById('flyer-preview-img') as HTMLImageElement;
  const statSavings = document.getElementById('stat-pill-savings') as HTMLElement;
  const statSize = document.getElementById('stat-pill-size') as HTMLElement;
  const previewUrlText = document.getElementById('preview-url-text') as HTMLElement;
  const hiddenFlyerUrl = document.getElementById('flyer_url') as HTMLInputElement;
  const btnReupload = document.getElementById('btn-reupload-flyer') as HTMLButtonElement;
  const btnDelete = document.getElementById('btn-delete-flyer') as HTMLButtonElement;
  const btnToggleManual = document.getElementById('btn-toggle-manual') as HTMLButtonElement;
  const manualForm = document.getElementById('manual-url-form') as HTMLDivElement;
  const manualInput = document.getElementById('manual_flyer_url') as HTMLInputElement;
  const btnApplyManual = document.getElementById('btn-apply-manual-url') as HTMLButtonElement;
  const mainForm = document.querySelector('form[method="POST"]') as HTMLFormElement;

  let isUploading = false;

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    const kb = bytes / 1024;
    if (kb < 1024) return kb.toFixed(1) + ' KB';
    return (kb / 1024).toFixed(2) + ' MB';
  }

  async function compressImageFile(file: File): Promise<{ blob: Blob; originalSize: number; compressedSize: number }> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const maxDim = 1200;
          let width = img.width;
          let height = img.height;

          if (width > height) {
            if (width > maxDim) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            }
          } else {
            if (height > maxDim) {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }

          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            return reject(new Error('Canvas context tidak tersedia.'));
          }
          ctx.drawImage(img, 0, 0, width, height);

          // Compress to WebP with 0.82 quality
          canvas.toBlob(
            (blob) => {
              if (blob) {
                resolve({
                  blob,
                  originalSize: file.size,
                  compressedSize: blob.size,
                });
              } else {
                canvas.toBlob(
                  (jpegBlob) => {
                    if (jpegBlob) {
                      resolve({
                        blob: jpegBlob,
                        originalSize: file.size,
                        compressedSize: jpegBlob.size,
                      });
                    } else {
                      reject(new Error('Gagal mengompres gambar.'));
                    }
                  },
                  'image/jpeg',
                  0.82
                );
              }
            },
            'image/webp',
            0.82
          );
        };
        img.onerror = () => reject(new Error('File bukan gambar yang valid.'));
        img.src = e.target?.result as string;
      };
      reader.onerror = () => reject(new Error('Gagal membaca file gambar.'));
      reader.readAsDataURL(file);
    });
  }

  async function handleFlyerSelected(file: File) {
    if (!file || !file.type.startsWith('image/')) {
      alert('Mohon pilih file gambar (JPG, PNG, atau WebP).');
      return;
    }

    try {
      isUploading = true;
      if (dropzone) dropzone.style.display = 'none';
      if (previewCard) previewCard.style.display = 'none';
      if (statusBar) statusBar.style.display = 'flex';
      if (statusTitle) statusTitle.textContent = 'Mengompresi gambar...';
      if (statusDetail) statusDetail.textContent = `Ukuran asli: ${formatBytes(file.size)}. Mengoptimalkan ukuran...`;

      // 1. Client-side compression
      const { blob, originalSize, compressedSize } = await compressImageFile(file);
      const savedPercent = Math.max(0, Math.round(((originalSize - compressedSize) / originalSize) * 100));

      if (statusTitle) statusTitle.textContent = 'Mengunggah flyer ke server...';
      if (statusDetail) statusDetail.textContent = `WebP teroptimasi (${formatBytes(compressedSize)} — hemat ${savedPercent}%). Mengunggah...`;

      // 2. Upload via API
      const formData = new FormData();
      const cleanFileName = (file.name.replace(/\.[^/.]+$/, '') || 'flyer') + '.webp';
      formData.append('file', blob, cleanFileName);

      const res = await fetch('/api/admin/upload', {
        method: 'POST',
        body: formData,
      });

      const json = await res.json();
      if (!res.ok) {
        throw new Error(json.error || 'Gagal mengunggah file flyer.');
      }

      // 3. Update UI
      const finalUrl = json.url;
      if (hiddenFlyerUrl) hiddenFlyerUrl.value = finalUrl;
      if (previewImg) previewImg.src = finalUrl;
      if (previewUrlText) previewUrlText.textContent = finalUrl;
      if (statSavings) statSavings.textContent = `Hemat ${savedPercent}% (${formatBytes(compressedSize)})`;
      if (statSize) statSize.textContent = `Asli: ${formatBytes(originalSize)}`;

      if (statusBar) statusBar.style.display = 'none';
      if (previewCard) previewCard.style.display = 'flex';
      if (dropzone) dropzone.style.display = 'none';
    } catch (err: any) {
      alert(err.message || 'Terjadi kesalahan saat mengompres/mengunggah gambar.');
      if (statusBar) statusBar.style.display = 'none';
      if (hiddenFlyerUrl?.value) {
        if (previewCard) previewCard.style.display = 'flex';
      } else {
        if (dropzone) dropzone.style.display = 'block';
      }
    } finally {
      isUploading = false;
      if (fileInput) fileInput.value = '';
    }
  }

  fileInput?.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) {
      handleFlyerSelected(fileInput.files[0]);
    }
  });

  // Drag and drop handlers
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('dropzone-active');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('dropzone-active');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dropzone-active');
    if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
      handleFlyerSelected(e.dataTransfer.files[0]);
    }
  });

  btnReupload?.addEventListener('click', () => {
    fileInput?.click();
  });

  btnDelete?.addEventListener('click', () => {
    if (confirm('Hapus gambar flyer ini?')) {
      if (hiddenFlyerUrl) hiddenFlyerUrl.value = '';
      if (previewImg) previewImg.src = '';
      if (previewUrlText) previewUrlText.textContent = '';
      if (previewCard) previewCard.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
    }
  });

  btnToggleManual?.addEventListener('click', () => {
    if (manualForm) {
      const isHidden = manualForm.style.display === 'none';
      manualForm.style.display = isHidden ? 'block' : 'none';
    }
  });

  btnApplyManual?.addEventListener('click', () => {
    const val = manualInput?.value.trim();
    if (!val) {
      alert('Masukkan URL gambar.');
      return;
    }
    if (hiddenFlyerUrl) hiddenFlyerUrl.value = val;
    if (previewImg) previewImg.src = val;
    if (previewUrlText) previewUrlText.textContent = val;
    if (statSavings) statSavings.textContent = 'URL Eksternal';
    if (statSize) statSize.textContent = '-';
    if (dropzone) dropzone.style.display = 'none';
    if (statusBar) statusBar.style.display = 'none';
    if (previewCard) previewCard.style.display = 'flex';
  });

  // Prevent form submission if upload is still in progress
  mainForm?.addEventListener('submit', (e) => {
    if (isUploading) {
      e.preventDefault();
      alert('Sedang mengunggah flyer, mohon tunggu hingga proses selesai.');
    }
  });
</script>

