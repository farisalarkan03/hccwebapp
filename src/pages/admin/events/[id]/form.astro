---
export const prerender = false;

import { requireAdmin } from '../../../../lib/auth';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { createServiceClient } from '../../../../lib/supabase';
import { FormBuilder } from '../../../../components/admin/FormBuilder';

const authResult = await requireAdmin(Astro);
if (authResult instanceof Response) return authResult;

const { admin } = authResult;
const { id: eventId } = Astro.params;

if (!eventId) return Astro.redirect('/admin/events');

const supabase = createServiceClient();

// Fetch event details
const { data: event, error: eventError } = await supabase
  .from('events')
  .select('id, title, slug, status')
  .eq('id', eventId)
  .is('deleted_at', null)
  .single();

if (eventError || !event) return Astro.redirect('/admin/events');

// Fetch existing form fields
const { data: fields } = await supabase
  .from('form_fields')
  .select('*')
  .eq('event_id', eventId)
  .order('sort_order', { ascending: true });

// Check existing registrations count
const { count: regCount } = await supabase
  .from('registrations')
  .select('id', { count: 'exact', head: true })
  .eq('event_id', eventId)
  .is('deleted_at', null);

const initialFields = (fields || []).map((f) => ({
  id: f.id,
  field_key: f.field_key,
  label: f.label,
  type: f.type,
  placeholder: f.placeholder,
  help_text: f.help_text,
  is_required: f.is_required,
  options: f.options as any,
  validation: f.validation as any,
  sort_order: f.sort_order,
}));
---

<AdminLayout title={`Form Builder: ${event.title}`} adminName={admin.name} adminRole={admin.role}>
  <div class="form-builder-page">
    <div class="fb-page-header">
      <div class="breadcrumb">
        <a href="/admin/events">Event</a>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <a href={`/admin/events/${event.id}/edit`}>{event.title}</a>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <span>Form Builder</span>
      </div>
      <div class="header-main-row">
        <div>
          <h2 class="fb-main-title">Form Builder: {event.title}</h2>
          <p class="fb-main-desc">Atur pertanyaan pendaftaran untuk calon peserta. Perubahan tersimpan secara otomatis.</p>
        </div>
        <div class="header-action-links">
          {event.status !== 'open' ? (
            <button
              type="button"
              class="btn btn-primary btn-sm btn-header-open-reg"
              id="btn-top-open-reg"
              data-event-id={event.id}
            >
              <span class="material-symbols-outlined" aria-hidden="true">rocket_launch</span>
              Buka Pendaftaran
            </button>
          ) : (
            <span class="status-pill-open" title="Pendaftaran kelas ini aktif dan dapat diakses peserta">
              <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
              Pendaftaran Dibuka
            </span>
          )}
          <a href={`/admin/events/${event.id}/edit`} class="btn btn-secondary btn-sm">
            <span class="material-symbols-outlined" aria-hidden="true">settings</span>
            Pengaturan Kelas
          </a>
          <a href={`/admin/events/${event.id}/peserta`} class="btn btn-secondary btn-sm">
            <span class="material-symbols-outlined" aria-hidden="true">group</span>
            Lihat Peserta
          </a>
        </div>
      </div>
    </div>

    {event.status === 'draft' && (
      <div class="draft-banner" id="draft-banner">
        <div class="draft-banner-content">
          <div class="draft-icon-wrap">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
          </div>
          <div class="draft-text-wrap">
            <strong class="draft-banner-title">Status Kelas Saat Ini: Draft (Pendaftaran Belum Dibuka)</strong>
            <p class="draft-banner-desc">
              Setelah selesai menyusun formulir pertanyaan, klik <strong>Buka Pendaftaran</strong> agar halaman publik pendaftaran langsung aktif dan calon peserta bisa mendaftar.
            </p>
          </div>
        </div>
        <button
          type="button"
          class="btn btn-primary btn-sm btn-banner-open"
          id="btn-banner-open-reg"
          data-event-id={event.id}
        >
          <span class="material-symbols-outlined" aria-hidden="true">rocket_launch</span>
          Buka Pendaftaran Sekarang
        </button>
      </div>
    )}

    <!-- Interactive Form Builder Component -->
    <FormBuilder
      client:load
      eventId={event.id}
      eventSlug={event.slug}
      eventTitle={event.title}
      initialFields={initialFields}
      registrationCount={regCount || 0}
      initialStatus={event.status}
    />
  </div>
</AdminLayout>

<script>
  const openRegBtns = [
    document.getElementById('btn-top-open-reg'),
    document.getElementById('btn-banner-open-reg'),
  ].filter(Boolean) as HTMLButtonElement[];

  openRegBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Buka pendaftaran untuk kelas ini sekarang? Form pendaftaran akan langsung aktif untuk calon peserta.')) {
        return;
      }
      btn.disabled = true;
      const originalHtml = btn.innerHTML;
      btn.innerHTML = '<span class="material-symbols-outlined spin-icon">sync</span> Membuka...';
      try {
        const eventId = btn.getAttribute('data-event-id');
        const res = await fetch(`/api/admin/events/${eventId}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'open' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal membuka pendaftaran');
        alert('Pendaftaran kelas berhasil dibuka! Calon peserta sudah dapat mendaftar.');
        window.location.reload();
      } catch (err: any) {
        alert(err.message || 'Terjadi kesalahan saat membuka pendaftaran.');
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    });
  });
</script>

<style>
  .form-builder-page {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--ink-600);
    margin-bottom: 6px;
  }

  .breadcrumb a {
    color: var(--pink-500);
    text-decoration: none;
  }

  .breadcrumb .material-symbols-outlined { font-size: 16px; }

  .header-main-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .fb-main-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 4px 0;
  }

  .fb-main-desc {
    font-size: 14px;
    color: var(--ink-600);
    margin: 0;
  }

  .header-action-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .btn-header-open-reg, .btn-banner-open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--pink-500);
    color: var(--white);
    border: none;
    font-weight: 500;
    box-shadow: 0 1px 2px rgba(224, 76, 136, 0.2);
    transition: all 150ms ease;
  }

  .btn-header-open-reg:hover, .btn-banner-open:hover {
    background: var(--pink-600);
    box-shadow: 0 2px 4px rgba(224, 76, 136, 0.3);
  }

  .status-pill-open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 500;
  }

  .status-pill-open .material-symbols-outlined {
    font-size: 16px;
  }

  /* Draft notification banner */
  .draft-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    box-shadow: var(--shadow-xs);
    flex-wrap: wrap;
  }

  .draft-banner-content {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
    min-width: 280px;
  }

  .draft-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: #fef3c7;
    color: #b45309;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .draft-icon-wrap .material-symbols-outlined {
    font-size: 22px;
  }

  .draft-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .draft-banner-title {
    font-size: 14px;
    color: #92400e;
  }

  .draft-banner-desc {
    font-size: 13px;
    color: #78350f;
    margin: 0;
    line-height: 1.4;
  }

  .spin-icon {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
