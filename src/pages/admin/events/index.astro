---
export const prerender = false;

import { requireAdmin } from '../../../lib/auth';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServiceClient } from '../../../lib/supabase';
import { formatDateWIB, formatRupiah } from '../../../lib/format';

const authResult = await requireAdmin(Astro);
if (authResult instanceof Response) return authResult;

const { admin } = authResult;
const supabase = createServiceClient();

let message = '';
let errorMessage = '';

// Handle actions (archive / duplicate)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action') as string;
    const eventId = formData.get('event_id') as string;

    if ((action === 'delete' || action === 'archive') && eventId) {
      const { error } = await supabase
        .from('events')
        .update({ deleted_at: new Date().toISOString(), updated_at: new Date().toISOString() })
        .eq('id', eventId);
      if (error) throw error;
      message = action === 'delete' ? 'Event berhasil dihapus.' : 'Event berhasil diarsipkan.';
    } else if (action === 'duplicate' && eventId) {
      // 1. Get original event
      const { data: orig, error: origError } = await supabase
        .from('events')
        .select('*')
        .eq('id', eventId)
        .single();
      if (origError || !orig) throw new Error('Event sumber tidak ditemukan.');

      // 2. Clone event
      const newSlug = `${orig.slug}-copy-${Date.now().toString(36)}`;
      const { data: newEv, error: newError } = await supabase
        .from('events')
        .insert({
          ...orig,
          id: undefined,
          title: `${orig.title} (Salinan)`,
          slug: newSlug,
          status: 'draft',
          deleted_at: null,
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString(),
        })
        .select('id')
        .single();

      if (newError || !newEv) throw new Error(newError?.message || 'Gagal menduplikasi event.');

      // 3. Clone form fields
      const { data: fields } = await supabase
        .from('form_fields')
        .select('*')
        .eq('event_id', eventId);

      if (fields && fields.length > 0) {
        const newFields = fields.map((f) => ({
          ...f,
          id: undefined,
          event_id: newEv.id,
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString(),
        }));
        await supabase.from('form_fields').insert(newFields);
      }

      // 4. Clone payment accounts & confirmators
      const { data: pAccounts } = await supabase
        .from('event_payment_accounts')
        .select('*')
        .eq('event_id', eventId);
      if (pAccounts && pAccounts.length > 0) {
        await supabase
          .from('event_payment_accounts')
          .insert(pAccounts.map((p) => ({ event_id: newEv.id, payment_account_id: p.payment_account_id })));
      }

      const { data: confs } = await supabase
        .from('event_confirmators')
        .select('*')
        .eq('event_id', eventId);
      if (confs && confs.length > 0) {
        await supabase
          .from('event_confirmators')
          .insert(confs.map((c) => ({ event_id: newEv.id, admin_id: c.admin_id, is_primary: c.is_primary })));
      }

      message = 'Event berhasil diduplikasi sebagai draft baru.';
    }
  } catch (err: any) {
    errorMessage = err.message || 'Gagal memproses aksi event.';
  }
}

// Fetch categories
const { data: categories } = await supabase
  .from('categories')
  .select('id, name, slug')
  .order('sort_order', { ascending: true });

// Fetch events with registrations count
const { data: eventsList } = await supabase
  .from('events')
  .select(`
    id,
    title,
    slug,
    category_id,
    date_start,
    location,
    price_per_couple,
    quota,
    status,
    show_on_landing,
    categories (
      name
    ),
    registrations (
      id,
      payment_status
    )
  `)
  .is('deleted_at', null)
  .order('date_start', { ascending: false });

const events = eventsList || [];

// Category filter from URL
const selectedCategory = Astro.url.searchParams.get('kategori') || 'all';

const filteredEvents = selectedCategory === 'all'
  ? events
  : events.filter((ev) => ev.category_id === selectedCategory);
---

<AdminLayout title="Kelola Event" adminName={admin.name} adminRole={admin.role}>
  <div class="events-page-container">
    <div class="page-header">
      <div>
        <h2 class="page-title">Daftar Event Happy Couple Class</h2>
        <p class="page-desc">Kelola jadwal kelas, pendaftar, formulir pendaftaran, dan akun scanner hari-H.</p>
      </div>
      <a href="/admin/events/baru" class="btn btn-primary btn-sm">
        <span class="material-symbols-outlined" aria-hidden="true">add</span>
        Tambah Kelas Baru
      </a>
    </div>

    {message && (
      <div class="alert alert-success" role="alert">
        <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
        <span>{message}</span>
      </div>
    )}

    {errorMessage && (
      <div class="alert alert-danger" role="alert">
        <span class="material-symbols-outlined" aria-hidden="true">error</span>
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Category Filter Tabs -->
    <div class="filter-tabs" role="tablist">
      <a
        href="/admin/events"
        class={`filter-tab ${selectedCategory === 'all' ? 'active' : ''}`}
        role="tab"
        aria-selected={selectedCategory === 'all'}
      >
        Semua Kategori ({events.length})
      </a>
      {categories?.map((cat) => {
        const count = events.filter((e) => e.category_id === cat.id).length;
        return (
          <a
            href={`/admin/events?kategori=${cat.id}`}
            class={`filter-tab ${selectedCategory === cat.id ? 'active' : ''}`}
            role="tab"
            aria-selected={selectedCategory === cat.id}
          >
            {cat.name} ({count})
          </a>
        );
      })}
    </div>

    <!-- Event Cards / Table -->
    {filteredEvents.length === 0 ? (
      <div class="card empty-card">
        <span class="material-symbols-outlined empty-icon" aria-hidden="true">event_busy</span>
        <h3 class="empty-title">Belum ada event di kategori ini</h3>
        <p class="empty-desc">Klik tombol "Tambah Kelas Baru" untuk membuka pendaftaran kelas baru.</p>
        <a href="/admin/events/baru" class="btn btn-primary btn-sm mt-3">
          <span class="material-symbols-outlined" aria-hidden="true">add</span>
          Buat Kelas Baru
        </a>
      </div>
    ) : (
      <div class="events-list">
        {filteredEvents.map((ev) => {
          const regs = ev.registrations || [];
          const totalRegistered = regs.length;
          const paidCount = regs.filter((r: any) => r.payment_status === 'paid').length;
          const quotaText = ev.quota ? `${totalRegistered} / ${ev.quota}` : `${totalRegistered} terdaftar`;

          return (
            <div class="event-card">
              <div class="event-card-header">
                <div class="event-main-meta">
                  <div class="category-badge-wrap">
                    <span class="category-badge">{ev.categories?.name || 'Tanpa Kategori'}</span>
                    <span class={`badge ${
                      ev.status === 'open' ? 'badge-ok' :
                      ev.status === 'closed' ? 'badge-warn' :
                      ev.status === 'done' ? 'badge-neutral' : 'badge-neutral'
                    }`}>
                      {ev.status === 'open' ? 'Buka' :
                       ev.status === 'closed' ? 'Tutup' :
                       ev.status === 'done' ? 'Selesai' : 'Draft'}
                    </span>
                    {ev.show_on_landing && (
                      <span class="landing-badge" title="Tampil di landing page">
                        <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                        Landing
                      </span>
                    )}
                  </div>
                  <h3 class="event-title">
                    <a href={`/admin/events/${ev.id}/peserta`} class="event-title-link">
                      {ev.title}
                    </a>
                  </h3>
                  <div class="event-submeta">
                    <span class="submeta-item">
                      <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                      {formatDateWIB(ev.date_start, { showTime: true })}
                    </span>
                    <span class="submeta-item">
                      <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                      {ev.location}
                    </span>
                    <span class="submeta-item">
                      <span class="material-symbols-outlined" aria-hidden="true">payments</span>
                      {formatRupiah(ev.price_per_couple)} / couple
                    </span>
                  </div>

                  <div class="event-public-link-wrap">
                    <span class="public-link-label">Halaman Publik:</span>
                    <a
                      href={`/daftar/${ev.slug}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="public-link-badge"
                      title="Buka Halaman Pendaftaran Publik di tab baru"
                    >
                      <span class="material-symbols-outlined icon-14" aria-hidden="true">open_in_new</span>
                      /daftar/{ev.slug}
                    </a>
                  </div>
                </div>

                <div class="event-stats-pill">
                  <div class="stat-pill-item">
                    <span class="stat-pill-val">{quotaText}</span>
                    <span class="stat-pill-lbl">Pendaftar</span>
                  </div>
                  <div class="stat-pill-divider"></div>
                  <div class="stat-pill-item">
                    <span class="stat-pill-val text-ok">{paidCount}</span>
                    <span class="stat-pill-lbl">Lunas</span>
                  </div>
                </div>
              </div>

              <div class="event-card-footer">
                <div class="event-quick-links">
                  <a
                    href={`/daftar/${ev.slug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-outline btn-sm btn-public-preview"
                    title="Buka Formulir Pendaftaran Publik"
                  >
                    <span class="material-symbols-outlined" aria-hidden="true">public</span>
                    Lihat Publik
                    <span class="material-symbols-outlined icon-xs" aria-hidden="true">open_in_new</span>
                  </a>
                  <a href={`/admin/events/${ev.id}/peserta`} class="btn btn-primary btn-sm">
                    <span class="material-symbols-outlined" aria-hidden="true">group</span>
                    Peserta ({totalRegistered})
                  </a>
                  <a href={`/admin/events/${ev.id}/form`} class="btn btn-secondary btn-sm">
                    <span class="material-symbols-outlined" aria-hidden="true">tune</span>
                    Form Builder
                  </a>
                  <a href={`/admin/events/${ev.id}/kehadiran`} class="btn btn-secondary btn-sm">
                    <span class="material-symbols-outlined" aria-hidden="true">qr_code_scanner</span>
                    Kehadiran
                  </a>
                  <a href={`/admin/events/${ev.id}/edit`} class="btn btn-secondary btn-sm">
                    <span class="material-symbols-outlined" aria-hidden="true">settings</span>
                    Edit
                  </a>
                </div>

                <div class="event-actions-dropdown">
                  <form method="POST" style="display:inline;">
                    <input type="hidden" name="_action" value="duplicate" />
                    <input type="hidden" name="event_id" value={ev.id} />
                    <button type="submit" class="btn-icon" title="Duplikat Kelas Beserta Form">
                      <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
                    </button>
                  </form>
                  <form method="POST" style="display:inline;" onsubmit="return confirm('Arsipkan event ini? Data pendaftar tetap tersimpan.');">
                    <input type="hidden" name="_action" value="archive" />
                    <input type="hidden" name="event_id" value={ev.id} />
                    <button type="submit" class="btn-icon btn-archive" title="Arsipkan Kelas">
                      <span class="material-symbols-outlined" aria-hidden="true">archive</span>
                    </button>
                  </form>
                  <form method="POST" style="display:inline;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus event ini? Event ini akan dihapus dari daftar dan website.');">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="event_id" value={ev.id} />
                    <button type="submit" class="btn-icon btn-delete" title="Hapus Event">
                      <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .events-page-container {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .page-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 4px 0;
  }

  .page-desc {
    font-size: 14px;
    color: var(--ink-600);
    margin: 0;
  }

  .alert {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    font-size: 14px;
  }

  .alert-success {
    background: var(--ok-bg);
    color: var(--ok);
    border: 1px solid rgba(46, 158, 107, 0.2);
  }

  .alert-danger {
    background: var(--danger-bg);
    color: var(--danger);
    border: 1px solid rgba(214, 69, 69, 0.2);
  }

  /* Filter tabs */
  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
  }

  .filter-tab {
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-600);
    text-decoration: none;
    background: var(--white);
    border: 1px solid var(--line);
    transition: all 150ms ease;
  }

  .filter-tab:hover {
    background: var(--pink-50);
    color: var(--ink-900);
  }

  .filter-tab.active {
    background: var(--pink-500);
    color: white;
    border-color: var(--pink-500);
  }

  /* Event cards */
  .events-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .event-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 150ms ease, border-color 150ms ease;
  }

  .event-card:hover {
    border-color: var(--pink-200);
    box-shadow: var(--shadow-md);
  }

  .event-card-header {
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .category-badge-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .category-badge {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-600);
    background: #f0edf0;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .landing-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 500;
    color: var(--pink-600);
    background: var(--pink-50);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .landing-badge .material-symbols-outlined { font-size: 13px; }

  .event-title {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }

  .event-title-link {
    color: var(--ink-900);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .event-title-link:hover {
    color: var(--pink-500);
  }

  .event-submeta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 13px;
    color: var(--ink-600);
  }

  .submeta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .submeta-item .material-symbols-outlined {
    font-size: 16px;
    color: var(--ink-400);
  }

  .event-stats-pill {
    display: flex;
    align-items: center;
    background: var(--pink-50);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 10px 18px;
    gap: 16px;
    flex-shrink: 0;
  }

  .stat-pill-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .stat-pill-val {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink-900);
  }

  .stat-pill-lbl {
    font-size: 11px;
    color: var(--ink-600);
  }

  .stat-pill-divider {
    width: 1px;
    height: 24px;
    background: var(--line);
  }

  .text-ok { color: var(--ok); }

  .event-card-footer {
    padding: 14px 24px;
    background: #faf7f8;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .event-quick-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .event-actions-dropdown {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .btn-icon {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-600);
    cursor: pointer;
    transition: all 150ms ease;
  }

  .btn-icon:hover {
    background: var(--pink-50);
    color: var(--pink-500);
    border-color: var(--pink-200);
  }

  .btn-archive:hover {
    color: var(--warn);
    background: var(--warn-bg);
  }

  .btn-delete:hover {
    color: var(--danger);
    background: var(--danger-bg);
    border-color: rgba(214, 69, 69, 0.3);
  }

  .btn-icon .material-symbols-outlined { font-size: 18px; }

  /* Public Link Styles */
  .event-public-link-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 12px;
  }

  .public-link-label {
    color: var(--ink-400);
    font-weight: 500;
  }

  .public-link-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--pink-600);
    background: var(--pink-50);
    border: 1px solid var(--pink-100);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-family: monospace;
    font-size: 12px;
    font-weight: 500;
    transition: all 150ms ease;
  }

  .public-link-badge:hover {
    background: var(--pink-100);
    color: var(--pink-700);
    border-color: var(--pink-200);
  }

  .btn-public-preview {
    background: var(--white);
    color: var(--pink-600);
    border-color: var(--pink-200);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  .btn-public-preview:hover {
    background: var(--pink-50);
    color: var(--pink-700);
    border-color: var(--pink-300);
  }

  .icon-14 { font-size: 14px; }
  .icon-xs { font-size: 14px; margin-left: 2px; }

  /* Empty state */
  .empty-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-align: center;
    padding: 60px 20px;
  }

  .empty-icon { font-size: 48px; color: var(--ink-400); margin-bottom: 12px; }
  .empty-title { font-size: 16px; font-weight: 600; color: var(--ink-900); margin: 0 0 6px 0; }
  .empty-desc { font-size: 14px; color: var(--ink-600); margin: 0; }
  .mt-3 { margin-top: 16px; }

  @media (max-width: 768px) {
    .event-card-header {
      flex-direction: column;
    }
    .event-stats-pill {
      width: 100%;
      justify-content: space-around;
    }
  }
</style>
