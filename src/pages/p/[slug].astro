---
export const prerender = false;

import PublicLayout from '../../layouts/PublicLayout.astro';
import { createServiceClient } from '../../lib/supabase';
import { formatDateWIB, formatRupiah } from '../../lib/format';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const supabase = createServiceClient();

// Fetch published page
const { data: page, error: pageError } = await supabase
  .from('pages')
  .select(`
    *,
    events (
      id,
      title,
      slug,
      date_start,
      location,
      price_per_couple,
      status
    )
  `)
  .eq('slug', slug)
  .eq('status', 'published')
  .is('deleted_at', null)
  .single();

if (pageError || !page) {
  return Astro.redirect('/');
}

const blocks = (page.blocks as any[]) || [];
---

<PublicLayout
  title={`${page.title} — Happy Couple Class`}
  description={page.summary || `${page.title}. Informasi dan edukasi pernikahan sakinah dari Happy Couple Class.`}
  image={page.cover_url || '/img/og-default.jpg'}
  ogType="article"
>
  <article class="page-article">
    <div class="container article-container">
      <!-- Breadcrumb -->
      <nav class="article-breadcrumb" aria-label="Navigasi">
        <a href="/">Beranda</a>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        <span aria-current="page">{page.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="article-header">
        <h1 class="article-title">{page.title}</h1>
        {page.published_at && (
          <span class="article-date">
            <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
            Dipublikasikan pada {formatDateWIB(page.published_at)}
          </span>
        )}
      </header>

      <!-- Cover Image -->
      {page.cover_url && (
        <div class="article-cover-wrap">
          <img src={page.cover_url} alt={page.title} class="article-cover-img" loading="eager" />
        </div>
      )}

      <!-- Blocks Content -->
      <div class="article-blocks">
        {blocks.map((blk) => (
          <div class="article-block">
            {blk.type === 'heading' && (
              blk.data.level === 'h3' ? (
                <h3 class="block-h3">{blk.data.text}</h3>
              ) : (
                <h2 class="block-h2">{blk.data.text}</h2>
              )
            )}

            {blk.type === 'text' && (
              <div class="block-text">
                {blk.data.text?.split('\n').map((paragraph: string) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            )}

            {blk.type === 'image' && blk.data.url && (
              <figure class="block-figure">
                <img src={blk.data.url} alt={blk.data.caption || page.title} class="block-img" loading="lazy" />
                {blk.data.caption && <figcaption class="block-caption">{blk.data.caption}</figcaption>}
              </figure>
            )}

            {blk.type === 'event_info' && page.events && (
              <div class="block-event-card">
                <div class="event-card-header">
                  <span class="material-symbols-outlined icon-pink" aria-hidden="true">celebration</span>
                  <div>
                    <h4 class="event-card-title">{page.events.title}</h4>
                    <span class="event-card-price">{formatRupiah(page.events.price_per_couple)} / couple</span>
                  </div>
                </div>
                <div class="event-card-meta">
                  <span class="meta-item">
                    <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                    {formatDateWIB(page.events.date_start, { showTime: true })}
                  </span>
                  <span class="meta-item">
                    <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                    {page.events.location}
                  </span>
                </div>
                <div class="event-card-action">
                  <a href={`/daftar/${page.events.slug}`} class="btn btn-primary btn-sm">
                    Daftar Kelas Ini
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                  </a>
                </div>
              </div>
            )}

            {blk.type === 'button' && (
              <div class="block-btn-wrap">
                <a
                  href={blk.data.action === 'event' ? `/daftar/${blk.data.event_slug}` : (blk.data.url || '#')}
                  class="btn btn-primary btn-lg"
                >
                  {blk.data.label || 'Daftar Sekarang'}
                  <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
              </div>
            )}

            {blk.type === 'faq' && blk.data.items && (
              <div class="block-faq-list">
                {blk.data.items.map((item: any) => (
                  <details class="faq-item" open>
                    <summary class="faq-question">
                      <span>{item.q}</span>
                      <span class="material-symbols-outlined faq-arrow" aria-hidden="true">expand_more</span>
                    </summary>
                    <div class="faq-answer">
                      <p>{item.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </article>
</PublicLayout>

<style>
  .page-article {
    padding: 36px 0 88px 0;
    background: var(--white);
    min-height: calc(100vh - 160px);
  }

  .article-container {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--ink-600);
  }
  .article-breadcrumb a { color: var(--pink-500); text-decoration: none; }
  .article-breadcrumb .material-symbols-outlined { font-size: 16px; color: var(--ink-400); }

  .article-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .article-title {
    font-size: 36px;
    font-weight: 700;
    color: var(--ink-900);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .article-date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--ink-400);
  }
  .article-date .material-symbols-outlined { font-size: 16px; }

  .article-cover-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }

  .article-cover-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-blocks {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 8px;
  }

  .block-h2 {
    font-size: 24px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .block-h3 {
    font-size: 19px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0;
  }

  .block-text {
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-900);
  }
  .block-text p { margin: 0 0 16px 0; }
  .block-text p:last-child { margin: 0; }

  .block-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .block-img {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
  }

  .block-caption {
    font-size: 12px;
    color: var(--ink-400);
    text-align: center;
  }

  .block-event-card {
    background: var(--pink-50);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .event-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .icon-pink { font-size: 28px; color: var(--pink-500); }

  .event-card-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 4px 0;
  }

  .event-card-price {
    font-size: 14px;
    font-weight: 700;
    color: var(--pink-600);
  }

  .event-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 13px;
    color: var(--ink-600);
  }

  .meta-item { display: inline-flex; align-items: center; gap: 6px; }
  .meta-item .material-symbols-outlined { font-size: 16px; color: var(--ink-400); }

  .event-card-action {
    display: flex;
    justify-content: flex-end;
  }

  .block-btn-wrap {
    display: flex;
    justify-content: center;
    padding: 8px 0;
  }

  .block-faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #faf8f9;
    overflow: hidden;
  }

  .faq-question {
    padding: 16px 20px;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-900);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-arrow { color: var(--ink-400); }
  .faq-item[open] .faq-arrow { transform: rotate(180deg); color: var(--pink-500); }
  .faq-answer { padding: 0 20px 16px 20px; font-size: 14px; color: var(--ink-600); line-height: 1.65; }
  .faq-answer p { margin: 0; }

  @media (max-width: 640px) {
    .article-title { font-size: 26px; }
    .page-article { padding: 24px 16px 64px 16px; }
  }
</style>
