---
export const prerender = false;

import PublicLayout from '../../../layouts/PublicLayout.astro';
import { SuccessCard } from '../../../components/register/SuccessCard';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');
---

<PublicLayout
  title="Pendaftaran Berhasil — Happy Couple Class"
  description="Pendaftaran kelas Anda berhasil direkam. Silakan lakukan pembayaran dan konfirmasi melalui WhatsApp."
  noindex={true}
>
  <div class="success-page">
    <SuccessCard client:load eventSlug={slug} />
  </div>
</PublicLayout>

<style>
  .success-page {
    background-color: var(--pink-50);
    min-height: calc(100vh - 160px);
    padding: 40px 16px 80px 16px;
  }
</style>
