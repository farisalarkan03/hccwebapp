{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hccwebapp",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
