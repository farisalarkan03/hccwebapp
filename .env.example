# Supabase Configuration
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key # HANYA di Cloudflare Pages Functions / Server environment

# Cloudflare Turnstile Captcha
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET=0x4AAAAAA...

# JWT Secret for /qrclass event staff auth (HMAC SHA-256)
QR_JWT_SECRET=your-random-32-char-jwt-secret-key-here

# Public site domain
PUBLIC_SITE_URL=https://happycoupleclass.com
